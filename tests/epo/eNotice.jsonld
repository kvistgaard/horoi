    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Prior information notice used as a Call For Competition using the light regime under Directive 25. Additional information: The light regime is generally used for procurement of social and other specific services. The light regime may enable reserving Contracts for social enterprises and sheltered workshops."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#historyNote": [
      {
        "@language": "en",
        "@value": "WG approval 16/09/2025"
      }
    ],
