    "http://purl.org/dc/terms/description": [
      {
        "@language": "en",
        "@value": "The eProcurement Ontology Submission core describes the concepts and properties representing the European Public Procurement Submission domain. The provision of these semantics offers the basis for a common understanding of the domain for all stakeholders ensuring the quality of data exchange and transparency. The ontology restrictions are published in a separate artefact."
      }
    ],
    "http://purl.org/dc/terms/issued": [
