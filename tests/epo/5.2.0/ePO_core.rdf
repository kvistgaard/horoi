  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasGrantedExclusiveRightsDescription">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Explanatory text about the applicable right entitling a public service operator to operate certain public passenger transport services on a particular route or network or in a particular area, to the exclusion of any other such operator. (epo:ContractTerm)</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Granted Exclusive Rights Description</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasHazardousClassID">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Specification of the hazardous nature of an item according to a classification schema. Provides detail of the classification and nature of a hazardous item.</skos:definition>
    <skos:prefLabel xml:lang="en">has Hazardous Class ID</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasAwardRank">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The position of the tender (i.e. whether the tender ended up first, second, third, etc.) in a design contest, some framework agreements with multiple winners (e.g. cascades) or an innovation partnership. (epo:TenderAwardOutcome)</skos:definition>
    <skos:editorialNote xml:lang="en">Used by eForms BT-171</skos:editorialNote>
    <skos:prefLabel xml:lang="en">has Award Rank</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#refersToPreviousProcedure">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Reference to a previous procedure. Additional Information: In the case of Direct Award Terms, this property points to a previous Procedure justifying the use of Direct Award without a prior publication.</skos:definition>
    <skos:editorialNote xml:lang="en">eForms BT-1252</skos:editorialNote>
    <skos:prefLabel xml:lang="en">refers To Previous Procedure</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasBuyerLegalType">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">A category that indicates the right of an Organisation to play the role of a buyer. Additional Information: The category also effects the rules that the buyer has to abide to within the public procurement procedure.</skos:definition>
    <skos:prefLabel xml:lang="en">has Buyer Legal Type</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasPlaceOfPerformanceAdditionalInformation">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Further details on the location of the execution of the contract. (epo:ContractTerm)</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 30/07/2019</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Place Of Performance Additional Information</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#refersToApplicablePeriod">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating the period to which the Response shall apply.</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 12/03/2024</skos:historyNote>
    <skos:prefLabel xml:lang="en">refers To Applicable Period</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasSubcontractingInvolved">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">List of Subcontractors and the subject matter they cover are required. Additional Information: The tenderer will ned to supply this information in the tender. (epo:SubcontractTerm)</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 28/02/2019</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Subcontracting Involved</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasBackorderQuantity">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating the number of Items that cannot be fulfilled immediately.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Backorder Quantity</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasCalculationBasedOn">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating the basis for the calculation of the energy efficiency.</skos:definition>
    <skos:prefLabel xml:lang="en">has Calculation Based On</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#specifiesContractor">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating that the instance of the concept involves the Contractor.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">specifies Contractor</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasPlannedPeriod">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating the foreseen time range.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Planned Period</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#isSubmissionForAllLotsRequired">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Indicates whether tenders must be submitted for all Lots. (epo:ProcedureTerm)</skos:definition>
    <skos:prefLabel xml:lang="en">is Submission For All Lots Required</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#isSMESuitable">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The procurement is suitable for small and medium enterprises (SMEs). (epo:LotGroup) The procurement is suitable for small and medium enterprises (SMEs). (epo:ProcurementElement)</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 15/10/2024</skos:historyNote>
    <skos:prefLabel xml:lang="en">is SME Suitable</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#definesSpecificPlaceOfPerformance">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating a ContractTerm has a specific place of performance.</skos:definition>
    <skos:prefLabel xml:lang="en">defines Specific Place Of Performance</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasNonAwardedContractNumber">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The number the contract would have had if it had been awarded. Additional information: This field is provided to support the data provided in the TED Standard Forms, and it should be discontinued in the future. (epo:LotAwardOutcome)</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 06/09/2022</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Non Awarded Contract Number</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasCalculationMethod">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
