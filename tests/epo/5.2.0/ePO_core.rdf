    <skos:prefLabel xml:lang="en">has Base Quantity</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#Fund">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">A financial resource used to support the Procurement. Additional Information: In the context of EU, Funds can be divided into programmes, actions and projects. Examples of EU funds are: the European Structural and Investment Funds, European Social Fund (ESF), the Connecting Europe Facility (CEF) programme, or the ISA2 programme and its actions (e.g. Action 2016.05 European Public Procurement Initiative, which supports the eProcurement Ontology under sub-action 3). Funds may change between the lot and the contract, for example in the case of an emergency crisis, a contract may be financed by a budget that was not foreseen in the call.</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 14/05/2019</skos:historyNote>
    <skos:prefLabel xml:lang="en">Fund</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#SecurityClearanceTerm">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#Term"/>
    <skos:definition xml:lang="en">Conditions and stipulations about the status requested of individuals allowing them access to classified information (state or organisational secrets) or to restricted areas, after completion of a thorough background check.</skos:definition>
    <skos:editorialNote xml:lang="en">Used by eForms BT-578, eForms BT-78, eForms BT-732</skos:editorialNote>
    <skos:historyNote xml:lang="en">WG Approval 20/06/2023</skos:historyNote>
    <skos:prefLabel xml:lang="en">Security Clearance Term</skos:prefLabel>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#definesInformationProvider">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating a ProcedureTerm has an information provider.</skos:definition>
    <skos:prefLabel xml:lang="en">defines Information Provider</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasCountryOfBirth">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The country in which the Person was born.</skos:definition>
    <skos:prefLabel xml:lang="en">has Country Of Birth</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#Tender">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#MaskableObject"/>
    <skos:definition xml:lang="en">Information submitted by the Economic Operator to specify its Offer regarding a specific Lot, in response to the call for Tender.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 03/05/2022</skos:historyNote>
    <skos:prefLabel xml:lang="en">Tender</skos:prefLabel>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasBankingIdentifier">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">An unique banking reference identifier of the Payee or Seller, assigned by the Payee or Seller bank.</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 11/07/2024</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Banking Identifier</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasHighestReceivedTenderValue">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Amount of the Tender with the highest value. Additional Information The value must correspond to an admissible tender. For example, tenders compliant with the procurement document requirements, not having an abnormally low price or cost, etc.</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 12/12/2019</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Highest Received Tender Value</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasTotalAccountingCurrencyTaxAmount">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating the overall Monetary Value of the Tax applied on the currency in which the financial transactions are recorded at the company level.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Total Accounting Currency Tax Amount</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#indicatesAwardToWinner">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Reveals the winner to whom the tender award outcome is attributed.</skos:definition>
    <skos:prefLabel xml:lang="en">indicates Award To Winner</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasSubcontracting">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating whether the Tender is subject to Subcontracting or not.</skos:definition>
    <skos:prefLabel xml:lang="en">has Subcontracting</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasOtherCountriesReceivedTenders">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The amount of Tenders received from European Economic Area countries other than that of the Buyer. (epo:SubmissionStatisticalInformation)</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 02/05/2024</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Other Countries Received Tenders</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasNonElectronicSubmissionDescription">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Textual explanation of how non-electronic information is to be presented. (epo:SubmissionTerm)</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 21/07/2020</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Non Electronic Submission Description</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasFixedValueType">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The method to interpret the fixed value as pertaining to a total or unit.</skos:definition>
    <skos:prefLabel xml:lang="en">has Fixed Value Type</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasThresholdType">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The method to interpret the threshold value as minimum or a maximum.</skos:definition>
    <skos:prefLabel xml:lang="en">has Threshold Type</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#usesCleanVehicleDirective">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The procurement falls within the scope of the European Parliament and Council 2009/33/EC (Clean Vehicles Directive – CVD). (epo:GreenProcurement)</skos:definition>
    <skos:prefLabel xml:lang="en">uses Clean Vehicle Directive</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#setsGroupingContextForLot">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Incorporates Lot.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 09/10/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">sets Grouping Context For Lot</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#describesProfessionRelevantLaw">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Explanatory text about the law concerning the profession. (epo:ProfessionalSuitabilitySummary)</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 02/05/2024</skos:historyNote>
    <skos:prefLabel xml:lang="en">describes Profession Relevant Law</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasECataloguePermission">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The extent to which electronic catalogues may be used in tenders.</skos:definition>
    <skos:prefLabel xml:lang="en">has E Catalogue Permission</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasFollowupContractInformation">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Further information about follow-up contracts, prizes and payments (for example non-monetary prizes, payments given for participation). (epo:DesignContestRegimeTerm)</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 03/09/2019</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Followup Contract Information</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasGroupType">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Form of collaboration agreement between organisations. Additional Information: This is not a legal type; not to be mistaken with epo:hasLegalFormType which may also be used for Organisation Groups. (epo:OrganisationGroup)</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 09/11/2021</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Group Type</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#DynamicPurchaseSystemTechnique">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#Technique"/>
    <skos:definition xml:lang="en">A Technique that allows the selection of Candidates throughout the Procedure via the Qualification Criteria, followed by individual Mini-Competitions for the Award of Purchase Contracts.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 23/05/2023</skos:historyNote>
    <skos:prefLabel xml:lang="en">Dynamic Purchase System Technique</skos:prefLabel>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasOfficialLanguage">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The language(s) in which the instances of the given concepts are officially available. These linguistic versions are equally legally valid.</skos:definition>
    <skos:prefLabel xml:lang="en">has Official Language</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#announcesPlannedProcurementPart">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating the formal communication of a Planned Procurement Part.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">announces Planned Procurement Part</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#specifiesDeliverable">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating the Deliverable.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">specifies Deliverable</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#fulfillsStrategicProcurement">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating that the concept has a Strategic Procurement goal.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">fulfills Strategic Procurement</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasRejectedQuantity">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating the non-accepted Quantity.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Rejected Quantity</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasUnitDescription">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">A narrative explanation defining the units of items being counted Additional information: This could be for example individual items or pack or two. (epo:Quantity)</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 09/11/2021</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Unit Description</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#isSupportedBy">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating the proof for the instance of the concept.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">is Supported By</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#concernsLotGroup">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relates to Lot Group.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">concerns Lot Group</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#isCoveredByGPA">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Specifies whether the Agreement on Government Procurement (GPA) applies. Additional information: The GPA aims to establish a multilateral framework of balanced rights and obligations relating to public contracts with a view to achieving the liberalization and expansion of world trade. (epo:ProcurementElement)</skos:definition>
    <skos:editorialNote xml:lang="en">Used by eForms BT-115</skos:editorialNote>
    <skos:historyNote xml:lang="en">WG Approval 15/10/2019</skos:historyNote>
    <skos:prefLabel xml:lang="en">is Covered By GPA</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasCountryCode">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating the Country code.</skos:definition>
    <skos:prefLabel xml:lang="en">has Country Code</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasRequestedDeliveryPeriod">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating the sought time range for the delivery.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Requested Delivery Period</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#isMultipleTenderSubmissionAllowed">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Tenderers may submit more than one competing tenders. (epo:SubmissionTerm)</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 10/10/2019</skos:historyNote>
    <skos:prefLabel xml:lang="en">is Multiple Tender Submission Allowed</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#SubmissionTerm">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#Term"/>
    <skos:definition xml:lang="en">Conditions and stipulations defining particularities of submitting Documents to the Buyer. Additional Information: These Documents can be Tenders, Request To Participate and expressions of interest.</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 14/07/2020</skos:historyNote>
    <skos:prefLabel xml:lang="en">Submission Term</skos:prefLabel>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasLegalFormType">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The classification of an Organisation according to legislation. Additional Information: Generally, this is defined for Tenderers who want to submit as an Organisation Group. Note that the codelist provided at national level should be used. (org:Organization)</skos:definition>
    <skos:prefLabel xml:lang="en">has Legal Form Type</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasNonEUReceivedTenders">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The amount of tenders received from economic operators in non-EU countries. (epo:SubmissionStatisticalInformation)</skos:definition>
    <skos:prefLabel xml:lang="en">has Non EU Received Tenders</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#isAccelerated">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Statement about the fact that the procedure will be reduced due to a state of urgency. Additional Information This modifies the time limit for the receipt of requests to participate or the receipt of tenders. (epo:Procedure)</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 20/08/2019</skos:historyNote>
    <skos:prefLabel xml:lang="en">is Accelerated</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasMaximumNumberOfCandidates">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Maximum number of candidates to be invited for the second stage of the procedure. (epo:MultipleStageProcedureTerm)</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 22/08/2019</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Maximum Number Of Candidates</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasExclusionGroundType">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating the exclusion ground classification.</skos:definition>
    <skos:prefLabel xml:lang="en">has Exclusion Ground Type</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasLoadingMeter">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The area of the Consignment in meters divided by the width of the truck, which is considered to be 2.4 meters.</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 18/06/2024</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Loading Meter</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasAwardStatus">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Indicates whether the lot is awarded, not awarded or still open.</skos:definition>
    <skos:prefLabel xml:lang="en">has Award Status</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasBalanceAmount">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating the outstanding amount that remains unpaid or unsettled.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Balance Amount</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasLegalFormRequirement">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The legal form to be taken by a Contractor. Additional Information: Generally, this is defined to cover the case where an Organisation Group is involved. Note that the codelist provided at national level should be used. (epo:ContractTerm)</skos:definition>
    <skos:prefLabel xml:lang="en">has Legal Form Requirement</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasWeightValueType">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">No definition. Waiting on CCCEV alignment.</skos:definition>
    <skos:prefLabel xml:lang="en">has Weight Value Type</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#MultipleStageProcedureTerm">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#Term"/>
    <skos:definition xml:lang="en">Conditions and stipulations defining particularities of Procedures carried out in several steps Additional Information: Generally this refers to Procedures where selection is carried out to qualify Tenderers who are then requested to submit the rest of their Tender for evaluation is Restricted Procedure.</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 15/04/2021</skos:historyNote>
    <skos:prefLabel xml:lang="en">Multiple Stage Procedure Term</skos:prefLabel>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasEstimatedTenderInvitationDate">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The planned date for the dispatch of the invitations to submit tenders. (epo:ProcessPlanningTerm)</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 09/11/2021</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Estimated Tender Invitation Date</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#announcesPlannedProcurement">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating the formal communication of a Planned Procurement.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">announces Planned Procurement</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#concernsProcedure">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relates to Procedure.</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 05/03/2024</skos:historyNote>
    <skos:prefLabel xml:lang="en">concerns Procedure</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#concernsReviewRequest">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relates to Review Request.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">concerns Review Request</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#ReviewIrregularitySummary">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#MaskableObject"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#StatisticalInformation"/>
    <skos:definition xml:lang="en">Overview of the number and type of requests the Buyer received to review any of its decisions (e.g. the Technical Specifications, Award Decision).</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 19/03/2024</skos:historyNote>
    <skos:prefLabel xml:lang="en">Review Irregularity Summary</skos:prefLabel>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#specifiesCatalogueProvider">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating that the instance of the concept involves the Catalogue Provider.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">specifies Catalogue Provider</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#TenderProcessor">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#AcquiringParty"/>
    <skos:definition xml:lang="en">A Role of an Agent responsible for processing Tenders.</skos:definition>
    <skos:prefLabel xml:lang="en">Tender Processor</skos:prefLabel>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasCreditAmount">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating the Monetary Value that reduces the amount owed.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Credit Amount</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#concernsLotAwardOutcome">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relates to Lot Award Outcome.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">concerns Lot Award Outcome</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasApproximateGroupFrameworkAgreementValue">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating the estimated Monetary Value of the Lot Group within the Framework Agreement.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Approximate Group Framework Agreement Value</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasNonAwardJustification">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">On hold; Enumeration.</skos:definition>
    <skos:prefLabel xml:lang="en">has Non Award Justification</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasGrossMonetaryValue">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The Monetary Value before any deductions.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Gross Monetary Value</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasAssociatedDocument">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Is related to a Document.</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 06/10/2024</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Associated Document</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasDPSScope">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Explanation as to whether a dps is used and by whom. The codelist to be used is at-voc:dps-usage which is available at http://publications.europa.eu/resource/dataset/dps-usage</skos:definition>
    <skos:prefLabel xml:lang="en">has DPS Scope</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasPerformingStaffQualificationInformation">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Explanation as to if and/or when information of the persons to carry out the contract is to be provided. The codelist to be used is at-voc:requirement-stage which is available at http://publications.europa.eu/resource/dataset/requirement-stage</skos:definition>
    <skos:prefLabel xml:lang="en">has Performing Staff Qualification Information</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasInvoicingPeriod">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating the time range for creating, sending, and managing Invoices.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Invoicing Period</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasProcurementLowestReceivedTenderValue">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The lowest received tender value for the procurement. Additional Information: This corresponds to section II.1.7.2. according to Regulation (EU) 2015/1986.</skos:definition>
    <skos:prefLabel xml:lang="en">has Procurement Lowest Received Tender Value</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasQualityTargetDescription">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Explanatory text about the performance goal. (epo:QualityTargetInformation)</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 23/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Quality Target Description</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#usesChannel">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating the Channel to be utilised.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">uses Channel</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#announcesCompletionOfContract">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating the formal communication of the Completion of a Contract.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">announces Completion Of Contract</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#Offer">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Document providing the Monetary Value and the details to fulfill the Requirements set out in the Procurement Documents or Request for Offer. Additional information: A quotation is considered to be an Offer in the eProcurement Ontology.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 09/02/2023</skos:historyNote>
    <skos:prefLabel xml:lang="en">Offer</skos:prefLabel>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasChangeJustification">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Code explaining the change.</skos:definition>
    <skos:prefLabel xml:lang="en">has Change Justification</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#canProvideNonDiscriminatoryEvidence">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation showing that an Organization can supply an Evidence with regard to the fulfilment of non-discriminatory criteria or the rules applied in order to reduce the number of participants.</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 12/03/2024</skos:historyNote>
    <skos:prefLabel xml:lang="en">can Provide Non Discriminatory Evidence</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasTotalTaxInclusiveAmount">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating the overall Monetary Value with Tax.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Total Tax Inclusive Amount</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasNutsCode">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating the Nomenclature of Territorial Units for Statistics code.</skos:definition>
    <skos:prefLabel xml:lang="en">has Nuts Code</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasDurationExtensionJustification">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The explanation of the reason why the framework agreement has an extended duration. Additional Information: The justification for exceptional cases when the duration of the framework agreement exceeds the legal limits. Four years in the case of the general procurement Directive, seven years in the case of the defence Directive, and eight years in the case of the sectoral Directive. (epo:FrameworkAgreementTerm)</skos:definition>
    <skos:editorialNote xml:lang="en">Used by eForms BT-109</skos:editorialNote>
    <skos:historyNote xml:lang="en">WG Approval 26/09/2019</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Duration Extension Justification</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasReviewBodyType">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating the Review Body Type.</skos:definition>
    <skos:prefLabel xml:lang="en">has Review Body Type</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasSubcontractingObligation">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The requirement the tender must meet with regard to subcontracting parts of the contract.</skos:definition>
    <skos:prefLabel xml:lang="en">has Subcontracting Obligation</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#definesCatalogueProvider">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating an AccessTerm has a CatalogueProvider.</skos:definition>
    <skos:prefLabel xml:lang="en">defines Catalogue Provider</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasRenewalDescription">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Any other information about the renewal(s). (epo:ContractTerm)</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 16/04/2019</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Renewal Description</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasCertification">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation to the proof of conformance.</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 30/05/2023</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Certification</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasValidityPeriod">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The relation indicating until when a given instance of a concept is applicable.</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 30/05/2023</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Validity Period</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasJustification">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">An explanation about the reasons for using the concept. (epo:DirectAwardTerm)</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 05/11/2019</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Justification</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#isRenewalIndicator">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Indicates whether the contract is subject to a renewal clause. (epo:ContractTerm)</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 09/11/2021</skos:historyNote>
    <skos:prefLabel xml:lang="en">is Renewal Indicator</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasReservedExecutionJustification">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">An explanation about why the Contract must be performed in the framework of sheltered employment programmes. (epo:ContractTerm)</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 23/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Reserved Execution Justification</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasAddressURL">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The resource identifier for a Channel. (cv:Channel)</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 26/03/2024</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Address URL</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#TenderAwardOutcome">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#ContextualProjection"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#MaskableObject"/>
    <skos:definition xml:lang="en">Result concerning the Tender attributed by the Awarder.</skos:definition>
    <skos:prefLabel xml:lang="en">Tender Award Outcome</skos:prefLabel>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasSourceSpecificationCustomisation">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating the Identifier of a tailored version of a standard.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 09/10/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Source Specification Customisation</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasMediumTenderPerLots">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en"><![CDATA[Tenders from medium-sized enterprise. <u>Additional Information:</u> See Commission Recommendation 2003/361/EC. (epo:SubmissionStatisticalInformation)]]></skos:definition>
    <skos:prefLabel xml:lang="en">has Medium Tender Per Lots</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasQuantityThreshold">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:prefLabel xml:lang="en">has Quantity Threshold</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#resultsFromUsingCandidateList">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation to indicate that a given type of Mini Competition Award Outcome is a consequence from using a given Selected Candidate List.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">results From Using Candidate List</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#OpeningTerm">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#Term"/>
    <skos:definition xml:lang="en">Conditions and stipulations defining particularities of the opening of Tenders. Additional Information: The opening of Tenders is the event when Tenders are made accessible for evaluation, it is generally the same date and time for all Tenders.</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 15/04/2021</skos:historyNote>
    <skos:prefLabel xml:lang="en">Opening Term</skos:prefLabel>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasOpeningDescription">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Further information about the opening of tenders. Additional Information For example, who may participate in the opening and whether any authorization is needed. (epo:OpeningTerm)</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 12/03/2019</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Opening Description</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasMainFeature">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Main features of the procedure and information about where the full rules for the procedure can be found. Additional Information: This information should be given when the procedure is not one of those mentioned in the procurement directives. This can be the case for example for concessions, for social and other specific services, and in case of voluntary publication of procurement procedures below the EU procurement thresholds. (epo:Procedure)</skos:definition>
    <skos:prefLabel xml:lang="en">has Main Feature</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#specifiesForeignSubsidiesMeasureConclusion">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating the Foreign Subsidy Measure Conclusion.</skos:definition>
    <skos:prefLabel xml:lang="en">specifies Foreign Subsidies Measure Conclusion</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasNoticePublicationNumber">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The identifier of the published Notice. Additional information: The format of this identifier is XXXXXXXX-YYYY. (epo:Notice)</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 26/03/2024</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Notice Publication Number</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#isSubcontractingPercentageKnown">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Indicates whether the ratio of the Subcontracting Estimate is defined. (epo:SubcontractingEstimate)</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 09/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">is Subcontracting Percentage Known</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasReservedExecution">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indication whether the execution of the contract must be performed in the framework of sheltered employment programmes.</skos:definition>
    <skos:prefLabel xml:lang="en">has Reserved Execution</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasTenderValidityPeriod">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The relation indicating until when a tender instance is applicable.</skos:definition>
    <skos:prefLabel xml:lang="en">has Tender Validity Period</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasBuyerItemID">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The general identifier assigned to the concept as defined by the Buyer.​</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 16/05/2023</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Buyer Item ID</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasEstimatedDuration">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating a Dynamic Purchase System has an estimated Duration.</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 28/11/2024</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Estimated Duration</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#refersToLot">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Reference to a Lot.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">refers To Lot</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasProcurementScopeDividedIntoLot">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Defines Lot.</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 25/03/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Procurement Scope Divided Into Lot</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#providesInformationOn">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Offers information about an instance of a concept.</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 05/03/2024</skos:historyNote>
    <skos:prefLabel xml:lang="en">provides Information On</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasBeneficialOwner">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">A role of any natural person(s) who ultimately owns or controls the organisation or on whose behalf a transaction or activity is being conducted. Additional Information: This role is defined in the directive EU 2015/849 and it's beyond the scope for public eProcurement domain.</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 14/09/2021</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Beneficial Owner</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasMaximumShare">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The maximum proportion of something to be distributed. Additional Information: In the case of subcontracting the share may refer to the proportion of works, services or supplies being subcontracted. (epo:SubcontractTerm)</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 17/09/2019 </skos:historyNote>
    <skos:prefLabel xml:lang="en">has Maximum Share</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#refersToPrevious">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Reference to a prior instance of the concept.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">refers To Previous</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasTotalQuantity">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The number of units required. Additional Information: The quantity needs to go along with the unit.</skos:definition>
    <skos:prefLabel xml:lang="en">has Total Quantity</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#ChangeInformation">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#ContextDescription"/>
    <skos:definition xml:lang="en">Alteration to previously provided details.</skos:definition>
    <skos:prefLabel xml:lang="en">Change Information</skos:prefLabel>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasTotalLineAmount">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating the overall Monetary Value of the Line.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Total Line Amount</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasPurpose">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating the Purpose of a concept.</skos:definition>
    <skos:prefLabel xml:lang="en">has Purpose</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#isBeneficialOwnerOf">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">A role of any natural person(s) who ultimately owns or controls the organisation or on whose behalf a transaction or activity is being conducted. Additional Information: This role is defined in the directive EU 2015/849 and it's beyond the scope for public eProcurement domain.</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 14/09/2021</skos:historyNote>
    <skos:prefLabel xml:lang="en">is Beneficial Owner Of</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasLength">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The horizontal measurement. Additional Information: The length is the longer side between the length and the width.</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 18/06/2024</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Length</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasAwardCriteriaOrderJustification">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The justification for only indicating the award criteria's order of importance, not their weighing. (epo:AwardEvaluationTerm)</skos:definition>
    <skos:editorialNote xml:lang="en">Used by eForms BT-733</skos:editorialNote>
    <skos:prefLabel xml:lang="en">has Award Criteria Order Justification</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#distributesOffer">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Sends the Offer.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">distributes Offer</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasPrimaryContactPoint">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating the main Contact Point.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Primary Contact Point</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#DesignContestRegimeTerm">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#Term"/>
    <skos:definition xml:lang="en">Conditions and stipulations defining particularities of a Design Contest.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 04/02/2021</skos:historyNote>
    <skos:prefLabel xml:lang="en">Design Contest Regime Term</skos:prefLabel>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#comprisesTenderAwardOutcome">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Incorporates TenderAwardOutcome.</skos:definition>
    <skos:prefLabel xml:lang="en">comprises Tender Award Outcome</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#ParticipationConditionsSummary">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#ProcurementCriteriaSummary"/>
    <skos:definition xml:lang="en">Overview of the Participation Conditions.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 19/03/2024</skos:historyNote>
    <skos:prefLabel xml:lang="en">Participation Conditions Summary</skos:prefLabel>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#summarisesInformationAboutEvidence">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating the Certificate that the information refers to.</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 12/03/2024</skos:historyNote>
    <skos:prefLabel xml:lang="en">summarises Information About Evidence</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasDeliveryLocation">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Location delivery area where the Item can be ordered to the given price.</skos:definition>
    <skos:prefLabel xml:lang="en">has Delivery Location</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasTotalAllowanceAmount">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating the overall Monetary Value of the Allowance.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Total Allowance Amount</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasEndpointIdentifier">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The identifier of the specific location, address, or interface where a system, service, or application can be accessed.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Endpoint Identifier</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasQualifiedValue">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Qualified value of the property, which is defined in a classification scheme. Additional Information: For example, the (0173-1#02-AAA026#007) drilling diameter of an item has value of 12 inches.</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 28/07/2022</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Qualified Value</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#isSubmittedForLot">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating that the instance of the concept is formally sent for a Lot.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">is Submitted For Lot</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasAwardJustification">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Description of the reason behind an award or non-award of a given Tender. Additional information: This is generally used when the non award justification code is set to "Other" and when the Lot is awarded. It may highlight the justification of the non-award of a Tender with regard to awarded Tenders. (epo:AwardOutcome)</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 25/02/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Award Justification</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasLateSubmissionPermission">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Whether economic operator-related information can be supplemented even after the submission deadline. Additional Information This is specific to the information on the economic operator and not the actual offer. This does not apply to the requests for clarification.</skos:definition>
    <skos:prefLabel xml:lang="en">has Late Submission Permission</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#concernsGreenProcurement">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relates to Green Procurement.</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 07/05/2024</skos:historyNote>
    <skos:prefLabel xml:lang="en">concerns Green Procurement</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#OfferIssuer">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#OfferingParty"/>
    <skos:definition xml:lang="en">The Role of an Agent that distributes an Offer.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 09/02/2023</skos:historyNote>
    <skos:prefLabel xml:lang="en">Offer Issuer</skos:prefLabel>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasInternetAddress">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The main web page used by the instance of the concept. (org:Organization) The main web page used by the instance of the concept. (cpov:ContactPoint)</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 01/06/2023</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Internet Address</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#ExclusionGround">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#QualificationCriterion"/>
    <skos:definition xml:lang="en">Criterion that describes a legal Requirement to be met by the Economic Operator to be a Candidate in the Procurement.</skos:definition>
    <skos:editorialNote xml:lang="en">Used by eForms BG-701</skos:editorialNote>
    <skos:historyNote xml:lang="en">WG Approval 31/10/2018</skos:historyNote>
    <skos:prefLabel xml:lang="en">Exclusion Ground</skos:prefLabel>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasSubmissionURL">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The identifier of a resource used for Submission. (epo:SubmissionTerm)</skos:definition>
    <skos:editorialNote xml:lang="en">Used by eForms BT-18, eForms BT-509</skos:editorialNote>
    <skos:historyNote xml:lang="en">WG approval 09/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Submission URL</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#definesPublicTransportationKilometers">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating the distance of passenger transport services of general economic interest provided to the public on a non-discriminatory and continuous basis.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">defines Public Transportation Kilometers</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasMaximumValue">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating the upper limit of the numerical quantity.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Maximum Value</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#amendsContract">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Modifies or changes the terms of an existing Contract.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">amends Contract</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasOutstandingQuantity">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The Quantity of non-despatched Goods Items.</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 05/06/2024</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Outstanding Quantity</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasEPayment">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Electronic means must be used for paying. (epo:ContractTerm)</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 09/11/2021</skos:historyNote>
    <skos:prefLabel xml:lang="en">has E Payment</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasEstimatedBuyerConcessionRevenue">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en"><![CDATA[The expected payments made by the buyer to the economic operator awarded the concession that are not directly related to the use of the concession. <u>Additional Information:</u> For example the public buyer pays a yearly fee to provide a ticketing solution to the public. The fee the public pays for every ticket sold through the solution is not included in this estimation but in the estimation of the user concession revenue.]]></skos:definition>
    <skos:editorialNote xml:lang="en">Used by eForms BT-160</skos:editorialNote>
    <skos:historyNote xml:lang="en">WG Approval 07/01/2020</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Estimated Buyer Concession Revenue</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#ReviewTerm">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#Term"/>
    <skos:definition xml:lang="en">Conditions and stipulations defining particularities of the review.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 23/11/2018</skos:historyNote>
    <skos:prefLabel xml:lang="en">Review Term</skos:prefLabel>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasDescriptionOfPrizes">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Explanatory text about Prizes. (epo:DesignContestRegimeTerm)</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 26/03/2024</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Description Of Prizes</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#BudgetProvider">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#AcquiringParty"/>
    <skos:definition xml:lang="en">A role of an agent whose Budget is used to pay for the Contract.</skos:definition>
    <skos:prefLabel xml:lang="en">Budget Provider</skos:prefLabel>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasCurrencyCodeListAgencyID">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Identifier of the agency that maintains the currency code list used. (epo:MonetaryValue)</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 13/04/2021</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Currency Code List Agency ID</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#isProcurementDocumentChanged">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
