<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
  xmlns:skos="http://www.w3.org/2004/02/skos/core#"
  xmlns:owl="http://www.w3.org/2002/07/owl#"
  xmlns:dcterms="http://purl.org/dc/terms/"
  xmlns:vann="http://purl.org/vocab/vann/"
  xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
  xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#ParticipationRequestProcessor">
    <rdfs:isDefinedBy>
      <owl:Ontology rdf:about="http://data.europa.eu/a4g/ontology#core">
        <dcterms:hasPart rdf:resource="http://data.europa.eu/a4g/ontology#acc"/>
        <dcterms:hasPart rdf:resource="http://data.europa.eu/a4g/ontology#awa"/>
        <dcterms:hasPart rdf:resource="http://data.europa.eu/a4g/ontology#cat"/>
        <dcterms:hasPart rdf:resource="http://data.europa.eu/a4g/ontology#con"/>
        <dcterms:hasPart rdf:resource="http://data.europa.eu/a4g/ontology#eva"/>
        <dcterms:hasPart rdf:resource="http://data.europa.eu/a4g/ontology#ful"/>
        <dcterms:hasPart rdf:resource="http://data.europa.eu/a4g/ontology#inv"/>
        <dcterms:hasPart rdf:resource="http://data.europa.eu/a4g/ontology#not"/>
        <dcterms:hasPart rdf:resource="http://data.europa.eu/a4g/ontology#ord"/>
        <dcterms:hasPart rdf:resource="http://data.europa.eu/a4g/ontology#pay"/>
        <dcterms:hasPart rdf:resource="http://data.europa.eu/a4g/ontology#qua"/>
        <dcterms:hasPart rdf:resource="http://data.europa.eu/a4g/ontology#req"/>
        <dcterms:hasPart rdf:resource="http://data.europa.eu/a4g/ontology#sub"/>
        <rdfs:label xml:lang="en">eProcurement Ontology - core</rdfs:label>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-06-01</dcterms:created>
        <dcterms:description xml:lang="en">The eProcurement Ontology core describes the concepts and properties representing the European Public Procurement domain. The provision of these semantics offers the basis for a common understanding of the domain for all stakeholders ensuring the quality of data exchange and transparency. The ontology restrictions are published in a separate artefact.</dcterms:description>
        <dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-10-10</dcterms:issued>
        <dcterms:license>© European Union, 2014. Unless otherwise noted, the reuse of the Ontology is authorised under the European Union Public Licence v1.2 (https://eupl.eu/).</dcterms:license>
        <dcterms:publisher>http://publications.europa.eu/resource/authority/corporate-body/PUBL</dcterms:publisher>
        <dcterms:title xml:lang="en">eProcurement Ontology - core</dcterms:title>
        <vann:preferredNamespacePrefix>epo</vann:preferredNamespacePrefix>
        <vann:preferredNamespaceUri>http://data.europa.eu/a4g/ontology#</vann:preferredNamespaceUri>
        <rdfs:comment>This version is automatically generated from ePO_core.xml on 2025-10-10</rdfs:comment>
        <rdfs:seeAlso rdf:resource="https://docs.ted.europa.eu/home/index.html"/>
        <rdfs:seeAlso rdf:resource="https://github.com/OP-TED/ePO/releases"/>
        <rdfs:seeAlso rdf:resource="https://joinup.ec.europa.eu/collection/eprocurement/solution/eprocurement-ontology/about"/>
        <rdfs:seeAlso rdf:resource="https://op.europa.eu/en/web/eu-vocabularies/e-procurement"/>
        <owl:imports rdf:resource="http://data.europa.eu/eli/ontology#"/>
        <owl:imports rdf:resource="http://data.europa.eu/m8g/"/>
        <owl:imports rdf:resource="http://purl.org/dc/terms/"/>
        <owl:imports rdf:resource="http://www.w3.org/2004/02/skos/core#"/>
        <owl:imports rdf:resource="http://www.w3.org/2006/time"/>
        <owl:imports rdf:resource="http://www.w3.org/ns/adms"/>
        <owl:imports rdf:resource="http://www.w3.org/ns/locn"/>
        <owl:imports rdf:resource="http://www.w3.org/ns/org#"/>
        <owl:imports rdf:resource="http://www.w3.org/ns/person"/>
        <owl:incompatibleWith>4.2.0</owl:incompatibleWith>
        <owl:priorVersion>http://data.europa.eu/a4g/ontology#core-5.1.0</owl:priorVersion>
        <owl:versionIRI rdf:resource="http://data.europa.eu/a4g/ontology#core-5.2.0"/>
        <owl:versionInfo>5.2.0</owl:versionInfo>
      </owl:Ontology>
    </rdfs:isDefinedBy>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#AcquiringParty"/>
    <skos:definition xml:lang="en">A Role of an Agent responsible for processing Requests To Participate.</skos:definition>
    <skos:prefLabel xml:lang="en">Participation Request Processor</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#Certifier">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The role of an agent who issues a certificate. Additional Information: The certifier is responsible for verifying and confirming the conformance of the instance of the concept to a defined set of criteria.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 16/05/2023</skos:historyNote>
    <skos:prefLabel xml:lang="en">Certifier</skos:prefLabel>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#comprisesAwardOutcome">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Incorporates AwardOutcome.</skos:definition>
    <skos:prefLabel xml:lang="en">comprises Award Outcome</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#definesLotGroup">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating a ProcedureTerm has a LotGroup.</skos:definition>
    <skos:prefLabel xml:lang="en">defines Lot Group</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasReceivedSmallTenders">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en"><![CDATA[Tenders from small enterprise. <u>Additional Information:</u> See Commission Recommendation 2003/361/EC. (epo:SubmissionStatisticalInformation)]]></skos:definition>
    <skos:prefLabel xml:lang="en">has Received Small Tenders</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#EmploymentInformationProvider">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">A Role of an Agent responsible for providing information concerning the general regulatory framework for employment protection and working conditions applicable in the place where the contract is to be performed.</skos:definition>
    <skos:prefLabel xml:lang="en">Employment Information Provider</skos:prefLabel>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasCurrencyCodeListAgencyName">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Name of the agency that maintains the currency code list used. (epo:MonetaryValue)</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 13/04/2021</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Currency Code List Agency Name</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#Document">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">A set of interrelated Business Information representing the Business facts and associated metadata. The information may be conveyed in any language, medium or form, including textual, numerical, graphic, cartographic, audio-visual forms, etc.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 23/05/2019</skos:historyNote>
    <skos:prefLabel xml:lang="en">Document</skos:prefLabel>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#isGuaranteeRequired">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The submitted information must include a financial commitment to be used in case of default. Additional Information: See the additional information provided in the definition of the 'Guarantee Description' element. (epo:SubmissionTerm)</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 21/07/2020</skos:historyNote>
    <skos:prefLabel xml:lang="en">is Guarantee Required</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#isContainedInTender">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating that the instance of the concept is part of a Tender.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">is Contained In Tender</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasTotalPaymentAmount">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating the overall paid Monetary Value.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Total Payment Amount</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasUnknownDuration">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Indicates the Duration is undetermined. (epo:ContractTerm) Indicates the Duration is undetermined. (epo:DynamicPurchaseSystemTechnique)</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 07/10/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Unknown Duration</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#specifiesOfferValidityPeriod">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating the time range in which an Offer is valid.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">specifies Offer Validity Period</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasDirectAwardJustification">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">List of reasons for using a procedure which allows awarding contracts directly without publishing a notice.</skos:definition>
    <skos:prefLabel xml:lang="en">has Direct Award Justification</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasOversupplyQuantity">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating the Quantity surplus.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Oversupply Quantity</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasNonEEAReceivedTenders">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The amount of tenders received from economic operators in non-EEA countries. (epo:SubmissionStatisticalInformation)</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 12/12/2019</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Non EEA Received Tenders</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasRestrictedAccessURL">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The internet address with information on accessing the restricted (part of the) procurement document. (epo:AccessTerm)</skos:definition>
    <skos:editorialNote xml:lang="en">Used by eForms BT-615</skos:editorialNote>
    <skos:prefLabel xml:lang="en">has Restricted Access URL</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#relatesToEFormSectionIdentifier">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Is about a specific eForms section.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">relates To E Form Section Identifier</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#fulfillsRequirement">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The requirement to which the concept meets.</skos:definition>
    <skos:prefLabel xml:lang="en">fulfills Requirement</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasTotalTaxExclusiveAmount">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating the overall Monetary Value without Tax.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Total Tax Exclusive Amount</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#ReviewDecision">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Information about Review Decisions.</skos:definition>
    <skos:prefLabel xml:lang="en">Review Decision</skos:prefLabel>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#isUsingEUFunds">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The procurement foresees funding by the Union. Additional Information: The funding may cover the whole procurement or part of the procurement. For example the European Structural and Investment Funds or grants awarded by the European Union. (epo:ProcurementObject)</skos:definition>
    <skos:prefLabel xml:lang="en">is Using EU Funds</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasLegalName">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The officially registered name of an organisation. (org:Organization)</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 10/01/2023</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Legal Name</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasPrepaidAmount">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating the Monetary Value that is paid in advance.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Prepaid Amount</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#ConcessionEstimate">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#Estimate"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#MaskableObject"/>
    <skos:definition xml:lang="en">Approximation concerning the foreseen Concession Contract.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 19/03/2024</skos:historyNote>
    <skos:prefLabel xml:lang="en">Concession Estimate</skos:prefLabel>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasSellerOrderID">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The identifier of the Order given by the Seller. Additional Information: This identifier is different than the identifier of the Order given by the Buyer and it is useful for internal purposes.</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 12/10/2023</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Seller Order ID</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#DirectAwardTerm">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#MaskableObject"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#Term"/>
    <skos:definition xml:lang="en">Conditions and stipulations defining particularities of the award of a Contract without prior publication. Addtional Information: Direct award may refer to a previous Procedure and/or specific Lot(s). It may also refer to other justified situations whereby there is no previous Procedure. See Directive 2014/24/EU Article 32.</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 22/11/2019</skos:historyNote>
    <skos:prefLabel xml:lang="en">Direct Award Term</skos:prefLabel>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#conformsToLegalBasis">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The Notice was designed in accordance with the given legal basis. Additional Information: This Notice can be used for Procedures which do not have the same legal basis. This holds for standard forms.</skos:definition>
    <skos:prefLabel xml:lang="en">conforms To Legal Basis</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#specifiesCatalogueReceiver">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating that the instance of the concept involves the Catalogue Receiver.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">specifies Catalogue Receiver</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasCustomerReference">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">An identifier assigned by the Buyer used for internal routing purposes.</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 04/03/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Customer Reference</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasCurrencyCodeListID">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Concept scheme URI used for the currency code list. (epo:MonetaryValue)</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 13/04/2021</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Currency Code List ID</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#TenderReceiver">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#AcquiringParty"/>
    <skos:definition xml:lang="en">A Role of an Agent responsible for receiving Tenders.</skos:definition>
    <skos:prefLabel xml:lang="en">Tender Receiver</skos:prefLabel>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasFrameworkAgreementMaximumValue">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating the maximum Monetary Value of the Framework Agreement.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Framework Agreement Maximum Value</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#ReviewProcedureInformationProvider">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#AcquiringParty"/>
    <skos:definition xml:lang="en">A Role of an Agent who is providing more information on the time limits for review Procedures.</skos:definition>
    <skos:prefLabel xml:lang="en">Review Procedure Information Provider</skos:prefLabel>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasTotalValue">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating the overall Monetary Value.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Total Value</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#MonetaryValue">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#MaskableObject"/>
    <skos:definition xml:lang="en">A number of monetary units specified using a given unit of currency. Additional information: In the pre-award phase of the procurement, all monetary values are considered to exclude VAT based on the Directive 2014/24/EU.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 13/04/2021</skos:historyNote>
    <skos:prefLabel xml:lang="en">Monetary Value</skos:prefLabel>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#isListedCompany">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en"><![CDATA[Public companies listed on a stock exchange and subject to disclosure requirements (either by stock exchange rules or through law or enforceable means), which impose requirements to ensure adequate transparency of beneficial ownership. <u>Additional Information:</u> In eForms this indicator is used when the nationality of beneficial owner is not provided because the Economic Operator is registered in a regulated market that is subject to disclosure requirements consistent with Union law or subject to equivalent international standards which ensure adequate transparency of ownership information. (epo:Business)]]></skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 21/11/2019</skos:historyNote>
    <skos:prefLabel xml:lang="en">is Listed Company</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#announcesAwardDecision">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating the formal communication of an Award Decision.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">announces Award Decision</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#issuedByCertifier">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating the Certifier responsible for providing the ItemCertificate. Additional Information: Certifier is a role played by an organisation.</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 26/07/2022</skos:historyNote>
    <skos:prefLabel xml:lang="en">issued By Certifier</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasContractConclusionDate">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en"><![CDATA[The date the contract was signed by the last signatory party. <u>Additional Information:</u> In exceptional cases contracts may be concluded without signature and therefore another date may be used. The date of contract conclusion is always later than the end of any standstill period. This concept is not to be confused with the date of completion/end of the contract. (epo:Contract)]]></skos:definition>
    <skos:editorialNote xml:lang="en">Used by eForms BT-145</skos:editorialNote>
    <skos:historyNote xml:lang="en">WG Approval 09/01/2020</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Contract Conclusion Date</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasFinancialOfferValue">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The value offered by the Tenderer for a Lot. Additional Information: This value is normally the one awarded for a winning Tender Lot. In case of negotiated procedures the original financial value may be reviewed and the offer updated.</skos:definition>
    <skos:editorialNote xml:lang="en">Used by eForms BT-720</skos:editorialNote>
    <skos:prefLabel xml:lang="en">has Financial Offer Value</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasManufacturerItemID">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The general identifier assigned to the concept as defined by the Manufacturer. ​</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 16/05/2023</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Manufacturer Item ID</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasMainClassification">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating the main Common Procurement Vocabulary code.</skos:definition>
    <skos:prefLabel xml:lang="en">has Main Classification</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#isBasedOnImplementingRegulation">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Indicates under which Implementing Regulation a Notice is created.</skos:definition>
    <skos:prefLabel xml:lang="en">is Based On Implementing Regulation</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#bindsBuyer">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Provides legal constraint on the Buyer.</skos:definition>
    <skos:prefLabel xml:lang="en">binds Buyer</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#isAdvancedElectronicSignatureRequired">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Advanced or qualified electronic signature or seal (as defined in Regulation (EU) No 910/2014) is required. The submitted information is required to be signed electronically. Additional Information: Signature can be defined as "data in electronic form which is attached to or logically associated with other data in electronic form and which is used by the signatory to sign. For more details on the meaning and uses of electronic signature you may consult different authoritative sources, a relevant one being for instance the Regulation (EU) 910/2014 on electronic identification and trust services for electronic transactions in the internal market. (epo:SubmissionTerm)</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 21/07/2020</skos:historyNote>
    <skos:prefLabel xml:lang="en">is Advanced Electronic Signature Required</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#bindsContractor">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Provides legal constraint on the Contractor.</skos:definition>
    <skos:prefLabel xml:lang="en">binds Contractor</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasFrameworkAgreementType">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The form of framework agreement used in a procurement procedure. Addition information: A concept to distinguish the different types of framework agreement, which are: 1. Framework agreement without reopening of competition, 2. Framework agreement with reopening of competition, or 3. Framework agreement partly without reopening of competition.</skos:definition>
    <skos:prefLabel xml:lang="en">has Framework Agreement Type</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasOptionsDescription">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The motivation and details about additional purchases that the buyer may undertake while the contract is valid. (epo:ContractTerm)</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 09/04/2019</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Options Description</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasUnverifiedTenders">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Offers received for which it has not been verified if they are admissible or inadmissible (e.g. because award criteria have been evaluated for all tenders and admissibility is checked only for the winning tender). (epo:SubmissionStatisticalInformation)</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 28/07/2020</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Unverified Tenders</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasAdditionalClassification">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating the additional Common Procurement Vocabulary code.</skos:definition>
    <skos:prefLabel xml:lang="en">has Additional Classification</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#specifiesEvidence">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating the Evidence.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">specifies Evidence</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#specifiesProcurementCriterion">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating the Procurement Criterion to be used.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">specifies Procurement Criterion</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#EconomicStandingSummary">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#SelectionCriteriaSummary"/>
    <skos:definition xml:lang="en">Overview of the financial viability of the economic operator.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 19/03/2024</skos:historyNote>
    <skos:prefLabel xml:lang="en">Economic Standing Summary</skos:prefLabel>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasDebitAmount">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating the Monetary Value that increases the amount owed.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Debit Amount</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#SelectionCriterion">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#QualificationCriterion"/>
    <skos:definition xml:lang="en">Criterion that describes a capacity Requirement that the Economic Operator needs to fulfill to participate in the procurement. Additional Information: Selection criteria may relate to: (a) suitability to pursue the professional activity; (b) economic and financial standing; (c) technical and professional ability</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 31/10/2018</skos:historyNote>
    <skos:prefLabel xml:lang="en">Selection Criterion</skos:prefLabel>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasSMEReceivedTenders">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en"><![CDATA[The amount of tenders received from micro, small and medium-sized enterprises. <u>Additional Information:</u> See Commission Recommendation 2003/361/EC. The ReceivedSMETenderLots is used when the size of the company is not exactly known. (epo:SubmissionStatisticalInformation)]]></skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 05/03/2020</skos:historyNote>
    <skos:prefLabel xml:lang="en">has SME Received Tenders</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasEnergyEfficiencyLabel">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating the Energy Efficiency Label.</skos:definition>
    <skos:prefLabel xml:lang="en">has Energy Efficiency Label</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasQualificationSystemDuration">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating a Qualification System has a Duration.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Qualification System Duration</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#EnvironmentalDocumentation">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#Documentation"/>
    <skos:definition xml:lang="en">Documentation concerning the general regulatory framework for Environmental Protection.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 11/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">Environmental Documentation</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#AdHocChannel">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/m8g/Channel"/>
    <skos:definition xml:lang="en">Web page where tools and devices for electronic communication that are not generally available can be downloaded free of charge.</skos:definition>
    <skos:editorialNote xml:lang="en">Used by eForms BT-724</skos:editorialNote>
    <skos:historyNote xml:lang="en">WG Approval 10/01/2023</skos:historyNote>
    <skos:prefLabel xml:lang="en">Ad Hoc Channel</skos:prefLabel>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasGroupFrameworkAgreementMaximumValue">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating the maximum Monetary Value of the Lot Group within the Framework Agreement.</skos:definition>
    <skos:editorialNote xml:lang="en">Used by eForms BT-156</skos:editorialNote>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Group Framework Agreement Maximum Value</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#leadBy">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The epo:OrganisationGroup epo:leadBy org:Organization was implemented to be used in case of an Economic Operator Group.</skos:definition>
    <skos:prefLabel xml:lang="en">lead By</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#CatalogueReceiver">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#AcquiringParty"/>
    <skos:definition xml:lang="en">A Role of an Agent processing a Catalogue. Additional Information: The Catalogue Receiver may not only receive it but also validate it, process it, etc. The Catalogue Receiver role is usually played by the agent that acts as a Buyer, or by another Agent that acts on behalf of the Buyer.</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 28/01/2021</skos:historyNote>
    <skos:prefLabel xml:lang="en">Catalogue Receiver</skos:prefLabel>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#refersToContractToBeModified">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Reference to a Contract which is altered.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">refers To Contract To Be Modified</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasNetAmount">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating the Monetary Value exclusive of taxes and after substracting price discounts.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Net Amount</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasInternalIdentifier">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating the in-house Identifier used by an Organization.</skos:definition>
    <skos:editorialNote xml:lang="en">Used by eForms BT-22</skos:editorialNote>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Internal Identifier</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasMinimumShare">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The minimum proportion of something to be distributed. Additional Information: In the case of subcontracting the share may refer to the proportion of works, services or supplies being subcontracted. (epo:SubcontractTerm)</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 17/09/2019</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Minimum Share</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasNoNegotiationNecessary">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The buyer reserves the right to award the contract on the basis of the initial tenders without any further negotiations. Additional information: See Article 29(4) of Directive 2014/24/EU. (epo:MultipleStageProcedureTerm)</skos:definition>
    <skos:prefLabel xml:lang="en">has No Negotiation Necessary</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#announcesLot">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating the formal communication of a Lot.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">announces Lot</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#requestsRemedyType">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating the demanded Remedy Type.</skos:definition>
    <skos:prefLabel xml:lang="en">requests Remedy Type</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasEstimatedInvitationToTenderDate">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The estimated date of dispatch of the invitations to submit tenders in two (or more) stage procedures. (epo:MultipleStageProcedureTerm)</skos:definition>
    <skos:editorialNote xml:lang="en">Used by eForms BT-130</skos:editorialNote>
    <skos:historyNote xml:lang="en">WG Approval 01/10/2019</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Estimated Invitation To Tender Date</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#Business">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/org#Organization"/>
    <skos:definition xml:lang="en">A private law company registered in a national registry.</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 28/04/2020</skos:historyNote>
    <skos:prefLabel xml:lang="en">Business</skos:prefLabel>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasMeasure">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating the unit used for stating the size.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Measure</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasTransportServiceType">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating the Transport Service category.</skos:definition>
    <skos:prefLabel xml:lang="en">has Transport Service Type</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#Contractor">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#OfferingParty"/>
    <skos:definition xml:lang="en">The Role of an Agent that has signed a Contract with a Buyer.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 08/11/2022</skos:historyNote>
    <skos:prefLabel xml:lang="en">Contractor</skos:prefLabel>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasNonAccessibilityCriterionJustification">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Reason for not applying accessibility criteria. (epo:SocialProcurement)</skos:definition>
    <skos:editorialNote xml:lang="en">Used by eForms BT-755</skos:editorialNote>
    <skos:historyNote xml:lang="en">WG Approval 05/03/2019</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Non Accessibility Criterion Justification</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasOverallPriceAwardCriteriaPonderation">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The weighting given to price. Additional Information: This weighting covers usually all price criteria against cost or quality criteria. (epo:AwardEvaluationTerm)</skos:definition>
    <skos:prefLabel xml:lang="en">has Overall Price Award Criteria Ponderation</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#SelectionEvaluationTerm">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#EvaluationTerm"/>
    <skos:definition xml:lang="en">Conditions and stipulations defining particularities of the evaluation of Selection Criteria.</skos:definition>
    <skos:prefLabel xml:lang="en">Selection Evaluation Term</skos:prefLabel>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#concernsAwardOutcome">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relates to Award Outcome.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">concerns Award Outcome</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#involvesBuyer">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Requires Buyer.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 09/10/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">involves Buyer</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#definesEstimatedContractDuration">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating a Contract has an estimated Duration.</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 28/11/2024</skos:historyNote>
    <skos:prefLabel xml:lang="en">defines Estimated Contract Duration</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasInadmissibleTenders">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en"><![CDATA[Tenders received that cannot be awarded due to non-compliance to procurement document requirements or having an abnormally low price or cost. <u>Additional Information: </u> Non-compliance with a Procurement Document requirements include exclusion grounds, selection criteria and submission deadline, etc. (epo:SubmissionStatisticalInformation)]]></skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 12/12/2019</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Inadmissible Tenders</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#AuxiliaryParty">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#AgentInRole"/>
    <skos:definition xml:lang="en">Role of an Agent who may be mentioned in the information exchanged during the Procurement Process but who does not play an active part in it.</skos:definition>
    <skos:prefLabel xml:lang="en">Auxiliary Party</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#ProcurementProcedureInformationProvider">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#AcquiringParty"/>
    <skos:definition xml:lang="en">A Role of an Agent responsible for providing additional information about the Procurement Procedure.</skos:definition>
    <skos:prefLabel xml:lang="en">Procurement Procedure Information Provider</skos:prefLabel>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasContractNatureType">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Subject of the acquisition.</skos:definition>
    <skos:prefLabel xml:lang="en">has Contract Nature Type</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#Mediator">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#AcquiringParty"/>
    <skos:definition xml:lang="en">A Role of an Agent that attempts to resolve a dispute between different Agents and come to an agreement.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 20/04/2021</skos:historyNote>
    <skos:prefLabel xml:lang="en">Mediator</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#ProfessionalSuitabilitySummary">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#SelectionCriteriaSummary"/>
    <skos:definition xml:lang="en">Overview of the professional ability required for the economic operator to execute the contract.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 19/03/2024</skos:historyNote>
    <skos:prefLabel xml:lang="en">Professional Suitability Summary</skos:prefLabel>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasFax">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The fax number used to reach a person or an organisation. (cpov:ContactPoint)</skos:definition>
    <skos:prefLabel xml:lang="en">has Fax</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#agreedByBuyer">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Accepted by Buyer.</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 10/06/2024</skos:historyNote>
    <skos:prefLabel xml:lang="en">agreed By Buyer</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#foreseesSubcontractor">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating that an Organization plans to have a Subcontractor. Additional information: In eForms, in a Result Notice, the foreseen Subcontractors in a Tender are associated to the Organization that proposes the Subcontractors. The Subcontractor is associated to the Organization, rather than the Tenderer, so that, in the case of multiple Organizations being a Tenderer, it is clear to which Organization the proposed Subcontractor is associated.</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 26/11/2024</skos:historyNote>
    <skos:prefLabel xml:lang="en">foresees Subcontractor</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#isProcurementDocumentRestricted">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The access to certain procurement documents is restricted. (epo:AccessTerm)</skos:definition>
    <skos:editorialNote xml:lang="en">Used by eForms BT-14</skos:editorialNote>
    <skos:historyNote xml:lang="en">WG Approval 10/10/2019</skos:historyNote>
    <skos:prefLabel xml:lang="en">is Procurement Document Restricted</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#TenderGroup">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Specific Offer in response to a Lot Group. Additional Information: This class is generally used to provide the Monetary Value in response to a Lot Group.</skos:definition>
    <skos:prefLabel xml:lang="en">Tender Group</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#AwardDecision">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Resolution of the Buyer as to the result of the Procurement Procedure.</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 14/11/2018</skos:historyNote>
    <skos:prefLabel xml:lang="en">Award Decision</skos:prefLabel>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasAllegedIrregularityType">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating the presumed Irregularity Type.</skos:definition>
    <skos:prefLabel xml:lang="en">has Alleged Irregularity Type</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasNetVolume">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The amount of space that is required without the packaging.</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 18/06/2024</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Net Volume</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasGroupLotEvaluationMethod">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Description of how lots and groups of lots are evaluated against one another in the procedure. (epo:ProcedureTerm)</skos:definition>
    <skos:prefLabel xml:lang="en">has Group Lot Evaluation Method</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasShortQuantity">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating the Quantity deficit.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Short Quantity</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#Reviewer">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#AcquiringParty"/>
    <skos:definition xml:lang="en">Role of an Agent who investigates the overall correctness of a Procurement Procedure, producing a related report. Additional Information: Any Organisation or Person may request a review of a Procurement Procedure.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 20/04/2021</skos:historyNote>
    <skos:prefLabel xml:lang="en">Reviewer</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#SocialProcurement">
    <dcterms:source xml:lang="en">Buying Social - A Guide to Taking Account of Social Considerations in Public Procurement (Publications Office of the European Union, 2011) https://op.europa.eu/en/publication-detail/-/publication/cb70c481-0e29-4040-9be2-c408cddf081f/language-en
</dcterms:source>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#StrategicProcurement"/>
    <skos:definition xml:lang="en">Approach whereby Buyers seek to procure by fulfilling social objectives. Additional Information: Socially Responsible Public Procurement (SRPP) - ‘SRPP’ means Procurement Operations that take into account one or more of the following social considerations: employment opportunities, decent work, compliance with social and labour rights, social inclusion (including persons with disabilities), equal opportunities, accessibility design for all, taking account of sustainability criteria, including ethical trade issues and wider voluntary compliance with corporate social responsibility (CSR), while observing the principles enshrined in the Treaty for the European Union (TFEU) and the Procurement Directives. See Article 18 and Annex X Directive 2014/24.</skos:definition>
    <skos:prefLabel xml:lang="en">Social Procurement</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#MiniCompetitionAwardOutcome">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#AwardOutcome"/>
    <skos:definition xml:lang="en">Result concerning the mini-competition that was attributed by the Awarder. Additional Information: The mini-competition is the process where multiple winners or candidates of previous stages of a procedure bid for a specific procurement. It is typically used in framework agreements where the suppliers have already been pre-selected, and the mini competition is used to determine which supplier is best suited for a particular project or contract. It is also used in a Dynamic Purchasing System where the suppliers come from a list of Candidates.</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 19/03/2024</skos:historyNote>
    <skos:prefLabel xml:lang="en">Mini Competition Award Outcome</skos:prefLabel>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#providesRulingOnRemedy">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">States the measures to be taken after a review procedure.</skos:definition>
    <skos:prefLabel xml:lang="en">provides Ruling On Remedy</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasElectronicSubmission">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Transmission of tenders is possible by electronic means of communication. (epo:Tender)</skos:definition>
    <skos:prefLabel xml:lang="en">has Electronic Submission</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasEstimatedValue">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">A forecast of the value of the procurement before competition. Additional Information: Different cases of estimated values may refer to a lot, the global value of the procedure, or of a combinatorial value of a group of lots. The forecast is calculated by the buyer and covers all revenues whether coming from the buyer or third parties. See for example recital (19), Article 5 of Directive 2014/24/EU and other articles from the rest of Directives about procurement. In the case of framework agreements and dynamic purchasing systems this refers to the maximum estimated value.</skos:definition>
    <skos:editorialNote xml:lang="en">Used by eForms BT-27, can be used for BT-157</skos:editorialNote>
    <skos:editorialNote xml:lang="en">Used by eForms BT-27,eForms BT-157</skos:editorialNote>
    <skos:historyNote xml:lang="en">WG Approval 05/12/2019</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Estimated Value</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasFormType">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">A categorisation of the steps in which the Notice is used.</skos:definition>
    <skos:prefLabel xml:lang="en">has Form Type</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasProcurementHighestReceivedTenderValue">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The highest received tender value for the procurement. Additional Information: This corresponds to section II.1.7.3. according to Regulation (EU) 2015/1986.</skos:definition>
    <skos:prefLabel xml:lang="en">has Procurement Highest Received Tender Value</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#describesProfession">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Explanatory text about the profession. (epo:ProfessionalSuitabilitySummary)</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 02/05/2024</skos:historyNote>
    <skos:prefLabel xml:lang="en">describes Profession</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasGrossWeight">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The total mass of goods including the packaging.</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 18/06/2024</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Gross Weight</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasOpeningDateTime">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Date and time for the opening of tenders. (epo:OpeningTerm)</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 12/03/2019</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Opening Date Time</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasReviewRequestFee">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating the charge or cost required for processing the Review Request.</skos:definition>
    <skos:editorialNote xml:lang="en">Used by eForms BT-795</skos:editorialNote>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Review Request Fee</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#ownsSystem">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">owns System</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasNationalProcedureRules">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The resource identifier where the information about the national rules applicable to the procedure can be found. (epo:ProcedureTerm)</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 02/05/2024</skos:historyNote>
    <skos:prefLabel xml:lang="en">has National Procedure Rules</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#isSubmittedBy">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating the submission of a tender by an economic operator.</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 18/05/2021</skos:historyNote>
    <skos:prefLabel xml:lang="en">is Submitted By</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasLaunchFrameworkAgreementMaximumValue">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating that the maximum value allowed for a Framework Agreement as defined by the Buyer at the outset.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Launch Framework Agreement Maximum Value</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#includesNationalCriterion">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating that a Criterion contains a Criterion that is specific to a given Member State.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 07/11/2023</skos:historyNote>
    <skos:prefLabel xml:lang="en">includes National Criterion</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#isCompetitionTerminated">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">No further contracts will be awarded in this procedure. Additional Information: This can be instantiated in the post award phase. PIN for Competition needs to be signaled. This field can be used even if no contracts are awarded in the contract award notice. (epo:ProcurementProcessInformation)</skos:definition>
    <skos:editorialNote xml:lang="en">Used by eForms BT-756</skos:editorialNote>
    <skos:prefLabel xml:lang="en">is Competition Terminated</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasStrategicProcurementDescription">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Self-explanatory text about a concept. (epo:StrategicProcurement)</skos:definition>
    <skos:prefLabel xml:lang="en">has Strategic Procurement Description</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasTotalChargeAmount">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating the overall Monetary Value of the Charge.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Total Charge Amount</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasAccessibilityDate">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The date at which unpublished data shall be published. (epo:NonPublishedInformation)</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 11/06/2020</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Accessibility Date</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#definesPrize">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating a DesignContestRegimeTerm has a Prize.</skos:definition>
    <skos:prefLabel xml:lang="en">defines Prize</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#EnergyEfficiencyInformation">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#ContextDescription"/>
    <skos:definition xml:lang="en">Information about the energy performance, consumption, or sustainability characteristics of a product, service, building, or process relevant to the execution or evaluation of a procurement procedure.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 11/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">Energy Efficiency Information</skos:prefLabel>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasNumberOfTendersConcerned">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Number of Tenders the instance of the concept relates to. (epo:InternationalProcurementInstrumentMeasuresInformation)</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 09/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Number Of Tenders Concerned</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasPaymentValueDiscrepancyJustification">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Justification for the actual value being different to the value in the initial Contract. (epo:ContractLotCompletionInformation)</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 26/03/2024</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Payment Value Discrepancy Justification</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#providesOrganisationEmployeeQuantity">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The number of people hired by the Organization.</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 05/03/2024</skos:historyNote>
    <skos:prefLabel xml:lang="en">provides Organisation Employee Quantity</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasAdditionalInformation">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Supplementary data about the instance of the concept. (epo:ProcurementElement) Supplementary data about the instance of the concept. (epo:ProcurementCriterion) Supplementary data about the instance of the concept. (epo:Document) Supplementary data about the instance of the concept. (epo:ChangeInformation)</skos:definition>
    <skos:editorialNote xml:lang="en">Used by eforms BT-300</skos:editorialNote>
    <skos:historyNote xml:lang="en">WG Approval 15/10/2019</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Additional Information</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#ProcedureTerm">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#MaskableObject"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#Term"/>
    <skos:definition xml:lang="en">Conditions and stipulations defining particularities of the Procedure.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 23/11/2018</skos:historyNote>
    <skos:prefLabel xml:lang="en">Procedure Term</skos:prefLabel>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasTotalCreditAmount">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating the overall Monetary Value that reduces the amount owed.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Total Credit Amount</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#QualityTargetInformation">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#ContextDescription"/>
    <skos:definition xml:lang="en">Information about a specific performance goal.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 23/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">Quality Target Information</skos:prefLabel>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasUnlimitedDuration">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Indicates the Duration is endless. (epo:ContractTerm) Indicates the Duration is endless. (epo:DynamicPurchaseSystemTechnique)</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 07/10/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Unlimited Duration</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasCertificationNumber">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The unique identifier of the certificate. (epo:Certificate)</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 26/07/2022</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Certification Number</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#isSecurityClearanceRequired">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Security Clearance is needed. (epo:SecurityClearanceTerm)</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 02/05/2024</skos:historyNote>
    <skos:prefLabel xml:lang="en">is Security Clearance Required</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#definesContractDuration">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating a Contract has a Duration.</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 28/11/2024</skos:historyNote>
    <skos:prefLabel xml:lang="en">defines Contract Duration</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasPenaltiesAndRewardsDescription">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Explanatory text about the applicable penalties and rewards. (epo:ContractTerm)</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Penalties And Rewards Description</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#ReliedUponEntity">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#OfferingParty"/>
    <skos:definition xml:lang="en">Economic Operator (who is not a Subcontractor) on which the Tenderer relies upon, to meet Selection Criteria.</skos:definition>
    <skos:prefLabel xml:lang="en">Relied Upon Entity</skos:prefLabel>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasDespatcherConsignmentID">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The identifier of the the Consignment given by the Despatcher.</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 10/06/2024</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Despatcher Consignment ID</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasConfidentialityJustification">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">A narrative explanation of why data is not published. Additional Information: This element is generally used when the non-publication-justification code chosen is "other". (epo:NonPublishedInformation)</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 09/11/2021</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Confidentiality Justification</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasEstimatedValidityPeriod">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating the time range in which the instance of the concept is valid.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Estimated Validity Period</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#providesDecisionFor">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Makes available the resolution.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">provides Decision For</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasTotalTaxAmount">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating the overall Monetary Value of the Tax applied.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Total Tax Amount</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasReviewDeadlineInformation">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The description of the time limits for review procedures. (epo:ReviewTerm)</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 01/10/2019</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Review Deadline Information</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#ReviewRequester">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#OfferingParty"/>
    <skos:definition xml:lang="en">Role of an Agent who requests the review of a (Procurement) Procedure.</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 23/10/2021</skos:historyNote>
    <skos:prefLabel xml:lang="en">Review Requester</skos:prefLabel>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasPaymentAccountIdentifier">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">A unique identifier of the financial payment account, at a payment service provider, to which payment should be made.</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 11/07/2024</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Payment Account Identifier</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasSubcontractor">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating the Subcontractor.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Subcontractor</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#providesRankToTender">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Makes available the assigned position for the Tender.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">provides Rank To Tender</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#AwardEvaluationTerm">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#EvaluationTerm"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#MaskableObject"/>
    <skos:definition xml:lang="en">Conditions and stipulations defining particularities of the evaluation of Award Criteria.</skos:definition>
    <skos:prefLabel xml:lang="en">Award Evaluation Term</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#EmploymentDocumentation">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#Documentation"/>
    <skos:definition xml:lang="en">Documentation concerning the general regulatory framework for employment protection and working conditions.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 11/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">Employment Documentation</skos:prefLabel>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasSMEReceivedTendersExcludingSubcontractors">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The amount of Tenders received from economic operators that are SMEs without taking into account Subcontractors. (epo:SubmissionStatisticalInformation)</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 09/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">has SME Received Tenders Excluding Subcontractors</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasReviewIrregularityCount">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The number of requests for a given irregularity. (epo:ReviewIrregularitySummary)</skos:definition>
    <skos:editorialNote xml:lang="en">Used by eForms BT-635</skos:editorialNote>
    <skos:prefLabel xml:lang="en">has Review Irregularity Count</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasPublicServiceObligationsDescription">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Explanatory text about the requirement defined or determined by a competent authority in order to ensure public passenger transport services in the general interest that an operator, if it were considering its own commercial interests, would not assume or would not assume to the same extent or under the same conditions without reward. (epo:ContractTerm)</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Public Service Obligations Description</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasLegalBasis">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The legal basis under which the procurement procedure takes place. Additional Information: For example European Directives or Regulations, national laws etc. The recommended code list is the example for the legal basis at the European level.</skos:definition>
    <skos:prefLabel xml:lang="en">has Legal Basis</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasPublicInterestExceptionJustification">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The reason why a derogation from international procurement access rules is applied under the International Procurement Instrument (IPI) Regulation. (epo:InternationalProcurementInstrumentMeasuresInformation)</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2026</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Public Interest Exception Justification</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#providesProcurementDocumentsInUnofficialLanguage">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating the unofficial language of the provided Procurement Documents.</skos:definition>
    <skos:prefLabel xml:lang="en">provides Procurement Documents In Unofficial Language</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasReceivedMicroTenders">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en"><![CDATA[The amount of tenders received from a micro enterprise. <u>Additional Information:</u> See Commission Recommendation 2003/361/EC. (epo:SubmissionStatisticalInformation)]]></skos:definition>
    <skos:prefLabel xml:lang="en">has Received Micro Tenders</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#isNonDisclosureAgreementRequired">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">A non-disclosure agreement is needed. Additional information: A non-disclosure agreement is a Contract between different parties which ensures information is not shared with other parties. (epo:NonDisclosureAgreementTerm)</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 26/03/2024</skos:historyNote>
    <skos:prefLabel xml:lang="en">is Non Disclosure Agreement Required</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#NonPublishedInformation">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#ContextDescription"/>
    <skos:definition xml:lang="en">Information about fields not published in this Notice. Additional Information: The non-published information may become available at a later date and may differ from one element to another within a given Document. Examples of fields that may not be immediately published are Winner, Tender and Procedure Lot Result, etc., e.g. for security reasons.</skos:definition>
    <skos:prefLabel xml:lang="en">Non Published Information</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#Lot">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#ProcurementObject"/>
    <skos:definition xml:lang="en">A qualitative, quantitative or strategic subdivision of the goods, services or works to be procured, allowing the award of one or more Contracts.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 12/09/2018</skos:historyNote>
    <skos:prefLabel xml:lang="en">Lot</skos:prefLabel>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasTicketsSalesRevenueAllocation">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Share of revenue with regard to ticket sales. (epo:ContractTerm)</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Tickets Sales Revenue Allocation</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#concernsReviewDecision">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relates to Review Decision.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">concerns Review Decision</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasEAuctionURL">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The internet address of the electronic auction. (epo:SubmissionTerm)</skos:definition>
    <skos:editorialNote xml:lang="en">Used by eForms BT-123</skos:editorialNote>
    <skos:prefLabel xml:lang="en">has E Auction URL</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#describesLotGroup">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Characterises Lot Group.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">describes Lot Group</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#CatalogueProvider">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#OfferingParty"/>
    <skos:definition xml:lang="en">A Role of an Agent compiling and supplying a Catalogue. Additional Information: The Catalogue Provider Role is usually played by the Agent that acts as a Seller, or by another Agent that acts on behalf of the Seller.</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 28/01/2021</skos:historyNote>
    <skos:prefLabel xml:lang="en">Catalogue Provider</skos:prefLabel>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasSelectionCriteriaStatedInProcurementDocuments">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The Selection Criteria are present in the Procurement Documents. (epo:SelectionCriteriaSummary)</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 02/05/2024</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Selection Criteria Stated In Procurement Documents</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#DirectContract">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#Contract"/>
    <skos:definition xml:lang="en">A Contract resulting from Lot Award Outcome. Additional information: A Framework Agreement is not a Direct Contract.</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 19/03/2024</skos:historyNote>
    <skos:prefLabel xml:lang="en">Direct Contract</skos:prefLabel>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasNumberOfTenderersInvited">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Number of economic operators invited to tender. Additional Information This may be used for single-stage procedures or to indicate the number of candidates invited to tender in multi-stage procedures. (epo:SubmissionStatisticalInformation)</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 01/12/2020</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Number Of Tenderers Invited</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#refersToLotGroupAwardInformation">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Reference to a Lot Group Award Information.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">refers To Lot Group Award Information</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasDispatchDate">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Date and time of transmission of a record to an Organization. (epo:Document)</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 31/08/2023</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Dispatch Date</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasMinimumSubcontractorsProposedObligation">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The minimum percentage of the contract value that the contractor must subcontract. Additional information: This is used for the competitive procedure described in Title III of Directive 2009/81/EC. (epo:SubcontractTerm)</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 09/11/2021</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Minimum Subcontractors Proposed Obligation</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasInvoiceLinePeriod">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating the time range of the Invoice Line.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Invoice Line Period</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasAdditionalInformationDeadline">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The time limit for requesting further information. Additional information: This is generally used to indicate the deadline for Economic Operators to request further information of the procedure before the submission deadline. (epo:AccessTerm)</skos:definition>
    <skos:editorialNote xml:lang="en">Used by eForms BT-13</skos:editorialNote>
    <skos:historyNote xml:lang="en">WG Approval 09/06/2020</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Additional Information Deadline</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#describesDirectAwardPrenotificationNotice">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Characterises Direct Award Prenotification Notice.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">describes Direct Award Prenotification Notice</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasMainActivity">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The principal sectoral area in which an organisation operates. Additional information: The activities associated with buyers are derived from the top level of the Classification of the functions of the government (COFOG) from the United Nations Statistics Division. The activities associated with buyer are derived from sectors explicitly falling within the sectoral directive (2014/25/EU Art. 8 - Art. 14).</skos:definition>
    <skos:prefLabel xml:lang="en">has Main Activity</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasOJSIssueNumber">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The issue identifier of the Supplement to the EU Official Journal. Additional information: The format of this identifier is XX-YYYY. (epo:Notice)</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 26/03/2024</skos:historyNote>
    <skos:prefLabel xml:lang="en">has OJS Issue Number</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#concernsNotice">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relates to Notice.</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 14/05/2024</skos:historyNote>
    <skos:prefLabel xml:lang="en">concerns Notice</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasDocumentRestrictionJustification">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">An explanation about the reasons why some procurement documents are restricted.</skos:definition>
    <skos:prefLabel xml:lang="en">has Document Restriction Justification</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasVehicleSegmentID">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The identifier of a part of the Transport Means.</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 25/06/2024</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Vehicle Segment ID</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#ProcurementDocument">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Document produced or referred to by the Buyer to describe or determine elements of the Procurement. Additional information: Procurement Documents are to be accessible since the date of publication of the Contract Notice or the prior information Notice when used as a call for competition. Examples of Procurement Documents are Technical Specifications, the Descriptive Document, proposed conditions of Contract, formats for the presentation of Documents by Candidates and Tenderers, information on generally applicable obligations. Other Documents related to the Procedure such as Notices are not considered to be Procurement Documents.</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 23/05/2019</skos:historyNote>
    <skos:prefLabel xml:lang="en">Procurement Document</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#PlannedProcurementPart">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#ProcurementElement"/>
    <skos:definition xml:lang="en">A subdivision of a Planned Procurement that may later become one or more Lots or a self-standing Procedure. Additional Information: A Lot or a Procedure can also cover one or more parts of the Planned Procurement.</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 20/06/2019</skos:historyNote>
    <skos:prefLabel xml:lang="en">Planned Procurement Part</skos:prefLabel>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasPaymentArrangement">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Information about financial clauses that will govern some economic aspects of the execution of the contract. Additional Information: These clauses usually refer to financial and payment provisions. This type of information should be structured instead of a free text in order to reuse it an ideal world. Unfortunately this is an information that in the real life no one is willing to provide pro-actively. WG Pending of discussion with eForms (epo:ContractTerm)</skos:definition>
    <skos:prefLabel xml:lang="en">has Payment Arrangement</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasLotAwardCombination">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The contracting authority reserves the right to award contracts combining lots or groups of lots. Additional Information: This property contains information about the Lots concerned. This property is required by the regulation (EU)-2015-1986 (modeled in the TED Standard Forms). (epo:ProcedureTerm)</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 23/08/2022</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Lot Award Combination</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#ParticipationCondition">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#ProcurementCriterion"/>
    <skos:definition xml:lang="en">Criterion that describes a Requirement to take part in a procurement.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 30/05/2023</skos:historyNote>
    <skos:prefLabel xml:lang="en">Participation Condition</skos:prefLabel>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#announcesContract">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating the formal communication of a Contract.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">announces Contract</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasReviewDeadline">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The time limit for review procedures. (epo:ReviewTerm)</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 09/11/2021</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Review Deadline</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasConcessionEstimatedValue">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating the estimated Monetary Value of the Concession.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Concession Estimated Value</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#refersToPreviousNotice">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Reference to a Notice published before.</skos:definition>
    <skos:editorialNote xml:lang="en">Used by eForms BT-758</skos:editorialNote>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">refers To Previous Notice</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#specifiesPlaceOfDelivery">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating the Location of the despatch.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">specifies Place Of Delivery</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasConfirmedIrregularityType">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating the confirmed Irregularity Type.</skos:definition>
    <skos:prefLabel xml:lang="en">has Confirmed Irregularity Type</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasSuccessiveReduction">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The number of solutions or tenders will be reduced in iterative evaluations for multiple staged procedures. Additional information: This refers to multiple-stage procedures (included two-stage procedures, at least). Open Procedures can be seen as one-stage procedures. (epo:MultipleStageProcedureTerm)</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 22/08/2019</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Successive Reduction</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasAwardDateScheduled">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Planned date for the award decision. (epo:ProcessPlanningTerm)</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 09/11/2021</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Award Date Scheduled</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasDeadline">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The time limit by which the security clearance must be submitted to the buyer. (epo:SecurityClearanceTerm)</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 02/05/2024</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Deadline</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasESenderDispatchDate">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The date and time the notice was transmitted electronically by the eSender to the Publications Office of the European Union. Additional Information: Typically, eSenders include national Official Journals, Buyers sending a large number of electronic Notices, public or private bodies acting on behalf of Buyers and eProcurement software developers. (epo:Notice)</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 20/06/2023</skos:historyNote>
    <skos:prefLabel xml:lang="en">has E Sender Dispatch Date</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasNoticeType">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating the Notice Type.</skos:definition>
    <skos:prefLabel xml:lang="en">has Notice Type</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#InternationalProcurementInstrumentMeasuresInformation">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#ContextDescription"/>
    <skos:definition xml:lang="en">Information about the legislative framework adopted by the European Union to promote reciprocity in international public procurement markets.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 11/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">International Procurement Instrument Measures Information</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#ReviewRequestSummary">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#MaskableObject"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#StatisticalInformation"/>
    <skos:definition xml:lang="en">Overview of the requests received by the Buyer to review any of its decisions (e.g. the technical specifications, award decision), as set out in Art. 1(5) of Directive 89/665/EEC and Directive 92/13/EEC, and about the complainants that submitted the requests.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 19/03/2024</skos:historyNote>
    <skos:prefLabel xml:lang="en">Review Request Summary</skos:prefLabel>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasESubmissionPermission">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The requirements as to what extent electronic submission is allowed.</skos:definition>
    <skos:prefLabel xml:lang="en">has E Submission Permission</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#LotAwardOutcome">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#AwardOutcome"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#MaskableObject"/>
    <skos:definition xml:lang="en">Result concerning the Lot that was attributed by the Awarder.</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 19/03/2024</skos:historyNote>
    <skos:prefLabel xml:lang="en">Lot Award Outcome</skos:prefLabel>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#isCalculatedOn">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The monetary amount to which the multiplier factor is applied in calculating the amount of this allowance, charge or tax.</skos:definition>
    <skos:prefLabel xml:lang="en">is Calculated On</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasAccessURL">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Location where the resource can be accessed. (epo:Document)</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 07/04/2022</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Access URL</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasEstimatedUserConcessionRevenue">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The estimated revenue coming from the use of the concession. Additional Information: Revenues are for example fees and fines. For example, the fees and fines coming from the cars using a motorway.</skos:definition>
    <skos:editorialNote xml:lang="en">Used by eForms BT-162</skos:editorialNote>
    <skos:prefLabel xml:lang="en">has Estimated User Concession Revenue</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#AcquiringCentralPurchasingBody">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#CentralPurchasingBody"/>
    <skos:definition xml:lang="en">Role of an Agent procuring activities conducted on a permanent basis in the form of the acquisition of supplies and/or services intended for other Buyers. Additional Information: In Public Procurement the Role of Acquiring Central Purchasing Body is carried out by a Central Purchasing Body for other Contracting Authorities.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 05/08/2021</skos:historyNote>
    <skos:prefLabel xml:lang="en">Acquiring Central Purchasing Body</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#AwardCriterion">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#MaskableObject"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#ProcurementCriterion"/>
    <skos:definition xml:lang="en">Criterion that describes a Requirement that the Tender needs to resolve and on which the Tender is evaluated and ranked.</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 05/11/2018</skos:historyNote>
    <skos:prefLabel xml:lang="en">Award Criterion</skos:prefLabel>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#describesResultNotice">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Characterises Result Notice.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">describes Result Notice</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasEInvoicingPermission">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating the eInvoicing Permission.</skos:definition>
    <skos:prefLabel xml:lang="en">has E Invoicing Permission</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#Asset">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Resource necessary for the provision of a service.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 09/10/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">Asset</skos:prefLabel>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#isAssignedForEvaluationOf">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating that the instance of the concept is selected for Evaluation.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">is Assigned For Evaluation Of</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasReceiptTenderDeadline">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The time limit until which the Tenders can be received. (epo:SubmissionTerm)</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 02/05/2024</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Receipt Tender Deadline</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasSubcontractingEstimatedValue">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The estimated value of a single subcontract.</skos:definition>
    <skos:editorialNote xml:lang="en">Used by eForms BT-553</skos:editorialNote>
    <skos:historyNote xml:lang="en">WG Approval 01/09/2020</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Subcontracting Estimated Value</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasAwardCriteriaEvaluationFormula">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The mathematical equation or any other description used for complicated weighing of criteria (e.g. non-linear weighing, the analytic hierarchy process) when a weighing cannot be expressed per criterion. (epo:AwardEvaluationTerm)</skos:definition>
    <skos:editorialNote xml:lang="en">Used by eForms BT-543</skos:editorialNote>
    <skos:prefLabel xml:lang="en">has Award Criteria Evaluation Formula</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasMaximumMeasure">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating the upper limit of the measure.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Maximum Measure</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#Procedure">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#ProcurementObject"/>
    <skos:definition xml:lang="en">A legally defined set of administrative activities conducted to conclude one or more Contracts. Additional Information The Procedure is categorised in the law according to different rules determining whether the Procedure is Open, Restricted, Negotiated with or without publicity, etc. (see Procedure Type).</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 20/08/2019</skos:historyNote>
    <skos:prefLabel xml:lang="en">Procedure</skos:prefLabel>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasExpectedDeliveryTime">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The expected amount of time between the order and delivery of an item.</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 26/07/2022</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Expected Delivery Time</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#foreseesProcurementObject">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating the instance of a Procurement Object that is planned. Additional Information: The properties of the Procurement Object that is foreseen should be read as foreseen properties. For example, Procedure isSMESuitable should be read as Procedure foreseesToBeSMESuitable. For example, Procedure isFundedBy should be read as Procedure foreseesToBeFundedBy.</skos:definition>
    <skos:prefLabel xml:lang="en">foresees Procurement Object</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasMandateIdentifier">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">An unique identifier for referencing the direct debit mandate, assigned by the Payee.</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 11/07/2024</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Mandate Identifier</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasThresholdValue">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The cut-off level for a given concept. Additional Information: This value is given as e.g. a minimum score, a maximum number of tenders with the highest score passing (see codelist at-voc:number-threshold). (cccev:Constraint)</skos:definition>
    <skos:prefLabel xml:lang="en">has Threshold Value</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#providesDocumentation">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Makes available the Documentation.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">provides Documentation</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasProcurementDocumentChangeDate">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The date and time of the change. (epo:ChangeInformation)</skos:definition>
    <skos:editorialNote xml:lang="en">Used by eForms BT-719</skos:editorialNote>
    <skos:historyNote xml:lang="en">WG Approval 5/11/2019</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Procurement Document Change Date</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#PlannedProcurement">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#ProcurementElement"/>
    <skos:definition xml:lang="en">A high-level description of a procurement activity foreseen by a Buyer.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 11/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">Planned Procurement</skos:prefLabel>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasMaximumOrderQuantity">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The maximum number of orderable units that can be ordered according to details provided in the catalogue line, such as price.</skos:definition>
    <skos:prefLabel xml:lang="en">has Maximum Order Quantity</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#CleanVehicleDirectiveInformation">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#ContextDescription"/>
    <skos:definition xml:lang="en">Information related to clean vehicles legislation. Additional information: In the European Union, the legislation concerned is the European Parliament and Council 2009/33/EC (Clean Vehicles Directive – CVD).</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 07/05/2024</skos:historyNote>
    <skos:prefLabel xml:lang="en">Clean Vehicle Directive Information</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#Subcontractor">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#OfferingParty"/>
    <skos:definition xml:lang="en">A Role of an Agent that has an agreement to perform part or all of the obligations of another Agents's Contract. Additional information For some Procedures, the Subcontractor signs as well the Contract between the Buyer and the Contractor. At tendering time, entities relied upon by the Economic Operators can be Subcontractors or not. When modelling ESPD we will analyze whether we need or not a Role named "relied upon".</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 05/08/2021</skos:historyNote>
    <skos:prefLabel xml:lang="en">Subcontractor</skos:prefLabel>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasCrossBorderLaw">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The applicable law when buyers from different countries procure together within one procurement procedure. (epo:ProcedureTerm)</skos:definition>
    <skos:editorialNote xml:lang="en">Used by eForms BT-09</skos:editorialNote>
    <skos:prefLabel xml:lang="en">has Cross Border Law</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasProcedureType">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Identification of the Procedure used.</skos:definition>
    <skos:prefLabel xml:lang="en">has Procedure Type</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#actsOnBehalfOf">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Represents.</skos:definition>
    <skos:prefLabel xml:lang="en">acts On Behalf Of</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#ProcurementServiceProvider">
    <dcterms:source xml:lang="en">Directive 2014/24/EU, Article 2, paragraphs 17 and 15.</dcterms:source>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#AcquiringParty"/>
    <skos:definition xml:lang="en">Role of a public or private body which offers ancillary purchasing activities on the market. Additional information: "Ancillary Purchasing Activities" means activities consisting in the provision of support to purchasing activities, in particular in the following forms: (a) technical infrastructure enabling Contracting Authorities to award Public Contracts or to conclude Framework Agreements for works, supplies or services; (b) advice on the conduct or design of public Procurement Procedures; (c) preparation and management of Procurement Procedures on behalf and for the account of the Contracting Authority concerned; This would be equivalent to the concept of 'ProcuringEntity' in OCDS: 'The Entity managing the Procurement, which may be different from the Buyer who is paying / using the items being procured'.</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 24/03/2020</skos:historyNote>
    <skos:prefLabel xml:lang="en">Procurement Service Provider</skos:prefLabel>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasQualificationCriteriaStatedInNotice">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The Qualification Criteria is specified in the Notice. (epo:QualificationCriterion)</skos:definition>
    <skos:historyNotice xml:lang="en">WG approval 09/09/2025</skos:historyNotice>
    <skos:prefLabel xml:lang="en">has Qualification Criteria Stated In Notice</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#ExclusionGroundsSummary">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#QualificationCriteriaSummary"/>
    <skos:definition xml:lang="en">Overview of the Exclusion Grounds.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 19/03/2024</skos:historyNote>
    <skos:prefLabel xml:lang="en">Exclusion Grounds Summary</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#PaymentExecutor">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#AcquiringParty"/>
    <skos:definition xml:lang="en">A Role of an Agent responsible for executing the Payment.</skos:definition>
    <skos:prefLabel xml:lang="en">Payment Executor</skos:prefLabel>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasAwardedValue">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The value of the procurement provided by the Award Decision. Additional Information: Different cases of awarded values may refer to a lot, the global value of the procedure, or of a combinatorial value of a group of lots. In the case of framework agreements and dynamic purchasing systems this refers to the maximum awarded value.</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 10/12/2019</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Awarded Value</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasElectronicSignature">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating that the instance of the concept has an Electronic Signature.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Electronic Signature</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasNonPublicationJustification">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The reason why data is not published.</skos:definition>
    <skos:prefLabel xml:lang="en">has Non Publication Justification</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#SubmissionStatisticalInformation">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#MaskableObject"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#StatisticalInformation"/>
    <skos:definition xml:lang="en">Statistical information about submissions on a given competition, either at Lot level or Mini-Competition level.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 30/05/2023</skos:historyNote>
    <skos:prefLabel xml:lang="en">Submission Statistical Information</skos:prefLabel>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasMaximumNumberOfRenewals">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The maximum number of times the contract can be renewed. Additional Information By renewing, the buyer reserves the right (i.e. not an obligation) to renew the contract (i.e. extend its duration) without a new procurement procedure. For example, a contract may be valid for one year and the buyer may keep a possibility to renew it (e.g. once, twice) for another three months, if he is content with the services he received. PLEASE REVIEW THIS DEFINITION AGAIN WITH THE WORKING GROUP. It was originally taken from eForms. (epo:ContractTerm)</skos:definition>
    <skos:prefLabel xml:lang="en">has Maximum Number Of Renewals</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#providesContractTotalPenaltyValue">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Makes available the overall Monetary Value of the penalties of the Contract.</skos:definition>
    <skos:editorialNote xml:lang="en">Used by eForms BT-782</skos:editorialNote>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">provides Contract Total Penalty Value</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#refersToAwardDecision">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Reference to an Award Decision.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">refers To Award Decision</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#specifiesDeliveryAgreementLocation">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating the Location from the Delivery Agreement.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">specifies Delivery Agreement Location</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#isAppointedBy">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating that by whom the instance of the concept is formally assigned.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">is Appointed By</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#foreseesTechnique">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating that an instance of the concept plans to apply a Technique.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">foresees Technique</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasSocialStandardsDescription">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Explanatory text about the standards required, including staff concerned, detail of their contractual rights and obligations and conditions under which employees are considered to be linked to the services. (epo:ContractTerm)</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Social Standards Description</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#answersReviewRequest">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Responds to a Review Request.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">answers Review Request</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasQualificationCriteriaStatedInProcurementDocuments">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The Qualification Criteria is specified in the Procurement Documents. (epo:QualificationCriterion)</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 09/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Qualification Criteria Stated In Procurement Documents</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasNationality">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating the country code to which the instance of the concept officially belongs to.</skos:definition>
    <skos:prefLabel xml:lang="en">has Nationality</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#refersToPreviousProcedureLot">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Reference to one or more Lots in a previous procedure. Additional Information: In the case of Direct Award Terms, this property points to a previous Procedure justifying the use of Direct Award without a prior publication.</skos:definition>
    <skos:editorialNote xml:lang="en">eForms BT-1252</skos:editorialNote>
    <skos:historyNote xml:lang="en">WG Approval 22/11/2019</skos:historyNote>
    <skos:prefLabel xml:lang="en">refers To Previous Procedure Lot</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#ReviewInformation">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Information about the Review Decision or the Review Request.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 11/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">Review Information</skos:prefLabel>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasDespatchedQuantity">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The Quantity that has been sent.</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 18/06/2024</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Despatched Quantity</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasMaximumNumberOfLotsToBeAwarded">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The maximum number of lots for which contract(s) can be awarded to one tenderer. Additional information: This field is used to complement the SubmissionTerms (which are at the Lot level) for the Procedure level which is covered by the regulation (EU)-2015-1986 (modeled in the TED Standard Forms). (epo:ProcedureTerm)</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 22/08/2019</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Maximum Number Of Lots To Be Awarded</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#refersToRole">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Reference to a Role.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">refers To Role</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#definesCatalogueReceiver">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating an AccessTerm has a CatalogueReceiver.</skos:definition>
    <skos:prefLabel xml:lang="en">defines Catalogue Receiver</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#ConcessionContract">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#Contract"/>
    <skos:definition xml:lang="en">A Contract between one or more Buyers and one or more Economic Operators giving the right to the Economic Operators to exploit the rights foreseen in the Contract which may include the receipt of Payments.</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 24/05/2022</skos:historyNote>
    <skos:prefLabel xml:lang="en">Concession Contract</skos:prefLabel>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#isDPSTerminated">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">End of the Dynamic Purchase System (DPS). Additional Information: This property can be used in the contract award notice even if no contracts are awarded. (epo:ProcurementProcessInformation)</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 22/11/2019</skos:historyNote>
    <skos:prefLabel xml:lang="en">is DPS Terminated</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#concernsContractTerm">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relates to Contract Term.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 23/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">concerns Contract Term</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasEstimatedInvitationToExpressInterestDate">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The estimated date of dispatch of the invitations to confirm interest. (epo:MultipleStageProcedureTerm)</skos:definition>
    <skos:editorialNote xml:lang="en">Used by eForms BT-631</skos:editorialNote>
    <skos:prefLabel xml:lang="en">has Estimated Invitation To Express Interest Date</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasReceiptDeadline">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The time limit for receiving submissions. Additional Information This is the deadline by which the buyer must receive submissions (e.g. tenders, requests to participate, clarifications, etc.) and is not the time at which the information is submitted by the economic operator. This attribute should be used for standard forms mappings. (epo:SubmissionTerm)</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 21/07/2020</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Receipt Deadline</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#isUsedForCandidateRestriction">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The criterion will be used to select the candidates to be invited for the second stage of a multistage procedure. Additional Information: This property is only used if a maximum number of candidates was foreseen in the procedure. (epo:SelectionCriterion)</skos:definition>
    <skos:editorialNote xml:lang="en">Used by eForms BT-40</skos:editorialNote>
    <skos:prefLabel xml:lang="en">is Used For Candidate Restriction</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#definesReviewProcedureInformationProvider">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating a ReviewTerm has a ReviewProcedureInformationProvider.</skos:definition>
    <skos:prefLabel xml:lang="en">defines Review Procedure Information Provider</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasTrackingID">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating that thedelivery has an identifier for traceability purposes.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Tracking ID</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#OrganisationGroup">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/org#Organization"/>
    <skos:definition xml:lang="en">Agreed collaboration of several Organisations. Additional Information: This concept has been created to fulfill the need to represent a grouping of Organisations that is not necessarily registered i.e, consortia.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 15/04/2021</skos:historyNote>
    <skos:prefLabel xml:lang="en">Organisation Group</skos:prefLabel>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#specifiesPlaceOfDespatch">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating the Location of the Despatch of the Goods Items to be delivered.</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 25/06/2024</skos:historyNote>
    <skos:prefLabel xml:lang="en">specifies Place Of Despatch</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#containsCandidate">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Includes Candidate.</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 14/05/2024</skos:historyNote>
    <skos:prefLabel xml:lang="en">contains Candidate</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#isRecurrent">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The Procurement being notified is likely to be included in another procedure in the foreseeable future. Additional Information: For example, a regularly re-tendered municipal service. This does not include awarding multiple contracts within a single qualification system, framework agreement, or a dynamic purchasing system. (epo:ProcurementObject)</skos:definition>
    <skos:editorialNote xml:lang="en">Used by eForms BT-94</skos:editorialNote>
    <skos:historyNote xml:lang="en">WG Approval 12/05/2020</skos:historyNote>
    <skos:prefLabel xml:lang="en">is Recurrent</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#ContractTerm">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#Term"/>
    <skos:definition xml:lang="en">Conditions and stipulations defining particularities of the Post Award Phase.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 23/11/2018</skos:historyNote>
    <skos:prefLabel xml:lang="en">Contract Term</skos:prefLabel>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasReviewProcedure">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The description of the method used to request the verification that the procedure has been carried out correctly. (epo:ReviewTerm)</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 09/11/2021</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Review Procedure</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasConstraint">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating that the instance of the concept has a Constraint.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Constraint</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#ContractLotCompletionInformation">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#ContextDescription"/>
    <skos:definition xml:lang="en">Information related to a given Lot at the end of the procurement.</skos:definition>
    <skos:prefLabel xml:lang="en">Contract Lot Completion Information</skos:prefLabel>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasLegalBasisDescription">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Explanatory text about the legal basis. (epo:ProcurementElement)</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 02/05/2024</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Legal Basis Description</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#isVariant">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Alternative solution to fulfil the buyer's needs as opposed to solutions indicated in the procurement documents. Additional Information: The permission to offer variants is only allowed if specified in a Contract Notice or a Prior Information Notice that used as a means for calling for a competition. The buyer lays out minimum requirements in the procurement documents that must be respected by tenderers submitting variants. (epo:Tender)</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 29/05/2019</skos:historyNote>
    <skos:prefLabel xml:lang="en">is Variant</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#substantiatesExclusionGround">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Demonstrates Exclusion Ground.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">substantiates Exclusion Ground</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasQualityTargetCode">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating the type of performance goal.</skos:definition>
    <skos:prefLabel xml:lang="en">has Quality Target Code</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasBusinessSize">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The category of the business depending on number of employees and turnover. Additional information: See Commission Recommendation of 6 May 2003 concerning the definition of micro, small and medium-sized enterprises.</skos:definition>
    <skos:prefLabel xml:lang="en">has Business Size</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasQuantityValue">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The numeric value of the quantity, including decimals. (epo:Quantity)</skos:definition>
    <skos:prefLabel xml:lang="en">has Quantity Value</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasTotalVehicles">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The number of all vehicles (regardless of whether clean or not) that have either been purchased, leased, rented, hired-purchased or their use has been contractually committed to for the provision of a purchased service. Additional Information: In the European Union, the legal requirements and scope for the provision of these vehicles or services are covered by Directive 2009/33/EC. (epo:CleanVehicleDirectiveInformation)</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 28/07/2020</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Total Vehicles</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#definesParticipationRequestReceiver">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating a ParticipationRequestTerm has a ParticipationRequestReceiver.</skos:definition>
    <skos:prefLabel xml:lang="en">defines Participation Request Receiver</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasFixedValue">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Constant number. (epo:AwardCriterion)</skos:definition>
    <skos:editorialNote xml:lang="en">Used by eForms BT-541, eForms BT-5422</skos:editorialNote>
    <skos:historyNote xml:lang="en">WG approval 09/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Fixed Value</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#FrameworkAgreementTechnique">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#Technique"/>
    <skos:definition xml:lang="en">Technique that establishes the terms governing Contracts to be awarded during a given Period, in particular with regard to Price and, where appropriate, the Quantity envisaged.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 18/05/2021</skos:historyNote>
    <skos:prefLabel xml:lang="en">Framework Agreement Technique</skos:prefLabel>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasSignificance">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Estimated percentage-share of Assets provided in overall Assets used to provide services under Contract. (epo:Asset)</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 09/10/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Significance</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasMaximumTemperature">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The highest tolerated temperature.</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 18/06/2024</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Maximum Temperature</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#SubcontractTerm">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#Term"/>
    <skos:definition xml:lang="en">A concept to describe the main information regarding the share of parts of the Contract to third parties.</skos:definition>
    <skos:prefLabel xml:lang="en">Subcontract Term</skos:prefLabel>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasWidth">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The measurement of the depth. Additional Information: The width is the shorter side between the length and the width.</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 18/06/2024</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Width</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasTotalAwardedValue">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The awarded value of all lots announced in this notice, including options and renewals. Additional information: The values of the individual Lots awarded under a framework agreement and mentioned in this notice are included. The values of the individual lots announced in a CAN are to be traced back and added to provide this value.</skos:definition>
    <skos:editorialNote xml:lang="en">Used by eForms BT-161</skos:editorialNote>
    <skos:historyNote xml:lang="en">WG Approval 03/12/2019</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Total Awarded Value</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#InnovativeProcurement">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#StrategicProcurement"/>
    <skos:definition xml:lang="en">Approach whereby Buyers seek to procure an innovative work, supply or service. Additional Information: ‘innovation’ means the implementation of a new or significantly improved product, service or process, including but not limited to production, building or construction processes, a new marketing method, or a new organizational method in business practices, workplace Organisation or external relations inter alia with the purpose of helping to solve societal challenges or to support the Europe 2020 strategy for smart, sustainable and inclusive growth; See: Directive 2014/24 Articles: 2, 26 (3), 31, 67 (2.a)</skos:definition>
    <skos:prefLabel xml:lang="en">Innovative Procurement</skos:prefLabel>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#foreseesSubcontracting">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating that an instance of the concept plans to be Subcontracted.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">foresees Subcontracting</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasGrossVolume">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The amount of space that is required including the packaging.</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 18/06/2024</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Gross Volume</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasNonAwardedContractTitle">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The title the contract would have had if it had been awarded. Additional information: This field is provided to support the data provided in the TED Standard Forms, and it should be discontinued in the future. (epo:LotAwardOutcome)</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 06/09/2022</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Non Awarded Contract Title</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasUnofficialLanguage">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The language translation(s) in which the instances of the given concepts are available. These linguistic versions are not an official translation, they are provided only for information.</skos:definition>
    <skos:prefLabel xml:lang="en">has Unofficial Language</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#TaxInformationProvider">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">A Role of an Agent responsible for providing information concerning the general regulatory framework for taxes applicable in the place where the contract is to be performed.</skos:definition>
    <skos:prefLabel xml:lang="en">Tax Information Provider</skos:prefLabel>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasModificationJustification">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Explanation of why a contract was modified. The codelist to be used is at-voc:modification-justification which is available at http://publications.europa.eu/resource/dataset/modification-justification</skos:definition>
    <skos:prefLabel xml:lang="en">has Modification Justification</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasMainActivityDescription">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Self-explanatory text about the Main Activity . Additional information: This field is used when the Main Activity is not available in the controlled list at-voc:main-activity-type . This is necessary in to cover data provided in the TED Standard Forms. It shall be deprecated in the future. (org:Organization)</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 06/09/2022</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Main Activity Description</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasGuaranteeDescription">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Information on the financial commitment required from the economic operator. Additional Information: 1. This information may include the amount and the way of delivering of the guarantee 2. The financial commitment may be retained by the buyer in the case the tenderer withdraws the submitted information (i.e. tender, expression of interest and request for participation, but not request for clarifications) before the award of the contract or does not sign the contract. 3. Usual modalities are bonds, cheques, loans, other. (epo:SubmissionTerm)</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 21/07/20</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Guarantee Description</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#playedBy">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating the Agent that fulfills the function of the instance of the concept.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 09/10/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">played By</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#Quantity">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">A counted number of non-monetary units possibly including fractions.</skos:definition>
    <skos:prefLabel xml:lang="en">Quantity</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#Tenderer">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#OfferingParty"/>
    <skos:definition xml:lang="en">A Role of an Agent that has submitted a Tender. Additional Information: A Tenderer is an Economic Operator or group of Economic Operators that has submitted a Tender.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 05/08/2021</skos:historyNote>
    <skos:prefLabel xml:lang="en">Tenderer</skos:prefLabel>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasMinimumMeasure">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating the lower limit of the measure.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Minimum Measure</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#definesParticipationRequestProcessor">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating a ParticipationRequestTerm has a ParticipationRequestProcessor.</skos:definition>
    <skos:prefLabel xml:lang="en">defines Participation Request Processor</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasAwardCriteriaStatedInProcurementDocuments">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The Award Criteria are provided in the Procurement Documents. (epo:AwardCriterion)</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 26/03/2024</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Award Criteria Stated In Procurement Documents</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasPredominance">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Estimated percentage-share of Assets provided compared to Assets used for activities other than the public services. (epo:Asset)</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 09/10/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Predominance</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#System">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdfs:subClassOf rdf:resource="http://xmlns.com/foaf/0.1/Agent"/>
    <skos:definition xml:lang="en">Software application used for performing Procurement activities.</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 28/04/2020</skos:historyNote>
    <skos:prefLabel xml:lang="en">System</skos:prefLabel>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#delegatesAncillaryActivitiesTo">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Entrusts ancillary purchasing activities to ProcurementServiceProvider.</skos:definition>
    <skos:prefLabel xml:lang="en">delegates Ancillary Activities To</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasItemConsumption">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating the amount of resources an Item uses.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Item Consumption</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasScheme">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The name of the identification scheme. (adms:Identifier)</skos:definition>
    <skos:prefLabel xml:lang="en">has Scheme</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasFormula">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The mathematical equation or any other description used for complicated weighing of criteria (e.g. non-linear weighing, the analytic hierarchy process) when a weighing cannot be expressed per criterion. (epo:ProcurementCriterion)</skos:definition>
    <skos:editorialNote xml:lang="en">Used by eForms BT-543</skos:editorialNote>
    <skos:prefLabel xml:lang="en">has Formula</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#specifiesCleanVehicleDirectiveContractType">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating the Clean Vehicle Directive Contract type.</skos:definition>
    <skos:prefLabel xml:lang="en">specifies Clean Vehicle Directive Contract Type</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasPaymentIdentifier">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating the Identifier of the Payment.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Payment Identifier</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#OriginatorRequest">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Document in which the Originator describes his needs.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 09/02/2023</skos:historyNote>
    <skos:prefLabel xml:lang="en">Originator Request</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#Prize">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">A reward given in a Contest.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval: 15/04/2021</skos:historyNote>
    <skos:prefLabel xml:lang="en">Prize</skos:prefLabel>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasLotReference">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating the instance of the concept refers to a Lot.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Lot Reference</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#isDesignContest">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">A competition which enables the buyer to acquire a plan or design via a jury. Additional information: Design contests have traditionally mostly been used in the fields of town and country planning, architecture and engineering or data processing, other purposes, such as to obtain plans for financial engineering The contest may include or not the award of prizes; (epo:Procedure)</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 04/02/2021</skos:historyNote>
    <skos:prefLabel xml:lang="en">is Design Contest</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#ElectronicSignature">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Data in electronic form which is attached to or logically associated with other data in electronic form and which is used by the signatory to sign. Additional information: The definition comes from REGULATION (EU) No 910/2014.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 19/03/2024</skos:historyNote>
    <skos:prefLabel xml:lang="en">Electronic Signature</skos:prefLabel>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasItemStandardID">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The general identifier assigned to the concept based on a standard scheme.​ Additional information: For example the GTIN scheme (Global Trade Item Number).</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 16/05/2023</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Item Standard ID</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasDurationAdditionalInformation">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Supplementary data about the Duration of the Contract. (epo:ContractTerm)</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 07/10/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Duration Additional Information</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasSourceVersionSpecification">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating the Identifier of the standard used and its version.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 09/10/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Source Version Specification</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#AwardCriteriaSummary">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#ProcurementCriteriaSummary"/>
    <skos:definition xml:lang="en">Overview of the Award Criteria.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 19/03/2024</skos:historyNote>
    <skos:prefLabel xml:lang="en">Award Criteria Summary</skos:prefLabel>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasActivityDescription">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">In the ePO ontology a taxonomy with all activities, based on different classifications (COFOG, UTILITIES, NACE), will be provided. In ePO this field is to be used exclusively to complement the definition attached to the MainActivityCode. However, in eForms there is the code "other" to cover undefined activities. For mapping to this eForms feature one could also use this property. (epo:Buyer)</skos:definition>
    <skos:prefLabel xml:lang="en">has Activity Description</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasEstimatedTotalSubcontracts">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The estimated amount of work to be subcontracted in the contract resulting from the lot. (epo:SubmissionStatisticalInformation)</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 09/11/2021</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Estimated Total Subcontracts</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasExtension">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The name of the addition to the Identifier. (adms:Identifier)</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Extension</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasInvoicedObjectIdentifier">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">An identifier for an object on which the invoice is based, given by the Seller.</skos:definition>
    <skos:prefLabel xml:lang="en">has Invoiced Object Identifier</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasCatalogueLineValidity">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The relation indicating until when a Catalogue Line instance is applicable.</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 21/09/2023</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Catalogue Line Validity</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasItemClassificationIdentifier">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The Identifier of the Item categorisation.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Item Classification Identifier</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#concernsMaskedObject">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relates to Masked Object.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">concerns Masked Object</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasAmountDueForPayment">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating the Monetary Value that has to be paid.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Amount Due For Payment</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasSchemeVersion">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The version of the identification scheme. (adms:Identifier)</skos:definition>
    <skos:prefLabel xml:lang="en">has Scheme Version</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasDeliveryPeriod">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating the time range for the delivery.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Delivery Period</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasReservedProcurement">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Explanation as to whether a procurement may be reserved for the participation of certain types of organisation.</skos:definition>
    <skos:prefLabel xml:lang="en">has Reserved Procurement</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasEntryIntoForceDate">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The date on which the contract enters into force. Additional information: This is generally the date on which the fulfillment of the contract begins. (epo:Contract)</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 05/11/2019</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Entry Into Force Date</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#concernsTotalItems">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Number of total Items the instance of the concept relates to. (epo:EnergyEfficiencyInformation)</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 09/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">concerns Total Items</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#foreseesTerm">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating that an instance of the concept plans to be subject to a Term.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">foresees Term</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasStartDate">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating the beginning date.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Start Date</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#updatesContractValue">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Changes the Contract Monetary Value.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">updates Contract Value</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasLanguage">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Language in which the submitted information is to be expressed.</skos:definition>
    <skos:prefLabel xml:lang="en">has Language</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasOptions">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The buyer reserves the right (not an obligation) for additional purchases from the contractor (while the contract is valid). (epo:ContractTerm)</skos:definition>
    <skos:prefLabel xml:lang="en">has Options</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasLowestReceivedTenderValue">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Amount of the Tender with the lowest value. Additional Information The value must correspond to an admissible tender. For example, tenders compliant with the procurement document requirements, not having an abnormally low price or cost, etc.</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 12/12/2019</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Lowest Received Tender Value</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasZeroEmissionVehicles">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The number of all zero-emission heavy-duty vehicles that have either been purchased, leased, rented, hired-purchased or their use has been contractually committed to for the provision of a purchased service. Additional Information: In the European Union, the legal requirements and scope for the provision of these vehicles or services are covered by Directive 2009/33/EC. (epo:CleanVehicleDirectiveInformation)</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 28/07/2020</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Zero Emission Vehicles</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasNetWeight">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The total mass of goods without the packaging.</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 18/06/2024</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Net Weight</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasMinimumValue">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating the lower limit of the numerical quantity.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Minimum Value</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#TechnicalSpecification">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">A set of documented Requirements applicable to the object of the Procurement. Additional Information: A specification often includes technical standards.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 20/04/2021</skos:historyNote>
    <skos:prefLabel xml:lang="en">Technical Specification</skos:prefLabel>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasDocumentType">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating the Document Type.</skos:definition>
    <skos:prefLabel xml:lang="en">has Document Type</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasHeight">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The vertical measurement.</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 18/06/2024</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Height</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasRecurrenceDescription">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Any additional information about the recurrence of the Procurement. Additional Information: For example estimated timing of the Procedure. (epo:ProcurementObject)</skos:definition>
    <skos:editorialNote xml:lang="en">Used by eForms BT-95</skos:editorialNote>
    <skos:historyNote xml:lang="en">WG Approval 16/01/2019</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Recurrence Description</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#involvesProcurementDocument">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Is about Procurement Document.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 09/10/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">involves Procurement Document</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#TechnicalAbilitySummary">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#SelectionCriteriaSummary"/>
    <skos:definition xml:lang="en">Overview of the expertise required for the economic operator to execute the contract.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 19/03/2024</skos:historyNote>
    <skos:prefLabel xml:lang="en">Technical Ability Summary</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#SubcontractingEstimate">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#Estimate"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#MaskableObject"/>
    <skos:definition xml:lang="en">Approximation concerning the foreseen Subcontracting.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 19/03/2024</skos:historyNote>
    <skos:prefLabel xml:lang="en">Subcontracting Estimate</skos:prefLabel>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasUnitCode">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating the Measurement Unit.</skos:definition>
    <skos:prefLabel xml:lang="en">has Unit Code</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#announcesRole">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating the formal communication of a Role.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">announces Role</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#signsAwardDecision">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating the Award Decision that was signed.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 09/10/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">signs Award Decision</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasSelectionCriterionType">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The classification of the selection criteria.</skos:definition>
    <skos:prefLabel xml:lang="en">has Selection Criterion Type</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#isSubjectToGrouping">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating that the instance of the concept belongs to a Group.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">is Subject To Grouping</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#EnvironmentalProtectionInformationProvider">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">A Role of an Agent responsible for providing information concerning the general regulatory framework for Environmental Protection applicable in the place where the contract is to be performed.</skos:definition>
    <skos:prefLabel xml:lang="en">Environmental Protection Information Provider</skos:prefLabel>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasTotalNumberOfComplainants">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The number of economic operators that requested the buyer to review any of its decisions (e.g. the technical specifications, award decision), as set out in Art. 1(5) of Directive 89/665/EEC and Directive 92/13/EEC. (epo:ReviewRequestSummary)</skos:definition>
    <skos:editorialNote xml:lang="en">Used by eForms BT-712</skos:editorialNote>
    <skos:historyNote xml:lang="en">WG Approval 11/04/2019</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Total Number Of Complainants</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasUUID">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">A universally unique identifier for an instance of this document.</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 12/05/2020</skos:historyNote>
    <skos:prefLabel xml:lang="en">has UUID</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#definesTenderReceiver">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating a SubmissionTerm has a TenderReceiver.</skos:definition>
    <skos:prefLabel xml:lang="en">defines Tender Receiver</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasMaximumParticipantsNumber">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The maximum number of participants in the framework agreement. Additional Information: Maximum number of tenderers who may be awarded a contract within the framework agreement. The number is a positive integer. (epo:FrameworkAgreementTerm)</skos:definition>
    <skos:editorialNote xml:lang="en">Used by eForms BT-113</skos:editorialNote>
    <skos:historyNote xml:lang="en">WG Approval 05/02/2019</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Maximum Participants Number</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#isReinforcedBy">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating an Evidence that supports the Response.</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 12/03/2024</skos:historyNote>
    <skos:prefLabel xml:lang="en">is Reinforced By</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#isJuryDecisionBinding">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Indicates whether the procuring entity is bound to apply the decision of the jury. (epo:DesignContestRegimeTerm)</skos:definition>
    <skos:prefLabel xml:lang="en">is Jury Decision Binding</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasReviewIrregularitySummary">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating the Review Irregularity Summary.</skos:definition>
    <skos:editorialNote xml:lang="en">Used by eForms BG-613</skos:editorialNote>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Review Irregularity Summary</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#UniqueResponsibleOfTheProcurement">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#AcquiringParty"/>
    <skos:definition xml:lang="en">A Role of an Agent that holds sole responsibility for initiating, managing, and executing a procurement procedure.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 11/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">Unique Responsible Of The Procurement</skos:prefLabel>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasTenderValidityDuration">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating the length of time a Tender remains valid.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Tender Validity Duration</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#isSubjectToTerm">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating that the instance of the concept applies a Term.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">is Subject To Term</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasOpeningURL">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The identifier of the address of the Opening of Tenders. (epo:OpeningTerm)</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 09/11/2021</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Opening URL</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasParticipationPayment">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Details on payments to participants (epo:DesignContestRegimeTerm)</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 09/11/2021</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Participation Payment</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasNonElectronicSubmissionJustification">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Reason for not accepting electronic information.</skos:definition>
    <skos:prefLabel xml:lang="en">has Non Electronic Submission Justification</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#concernsInternationalProcurementInstrumentMeasure">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relates to International Procurement Instrument Measure.</skos:definition>
    <skos:prefLabel xml:lang="en">concerns International Procurement Instrument Measure</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#concernsProcurementElement">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relates to Procurement Element.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">concerns Procurement Element</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#ParticipationRequestTerm">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#Term"/>
    <skos:definition xml:lang="en">Conditions and stipulations defining particularities of requesting participation in a Procedure.</skos:definition>
    <skos:prefLabel xml:lang="en">Participation Request Term</skos:prefLabel>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#foreseesConcession">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating that an instance of the concept plans to have a Concession.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">foresees Concession</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#isToBeRelaunched">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Indicator of whether the procurement object is to be relaunched. Additional information: This can be instantiated in the post award phase. (epo:ProcurementProcessInformation)</skos:definition>
    <skos:editorialNote xml:lang="en">Used by eForms BT-634</skos:editorialNote>
    <skos:historyNote xml:lang="en">WG Approval 18/01/2022</skos:historyNote>
    <skos:prefLabel xml:lang="en">is To Be Relaunched</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#NoticeAwardInformation">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#ContextDescription"/>
    <skos:definition xml:lang="en">Information about an Award Notice.</skos:definition>
    <skos:prefLabel xml:lang="en">Notice Award Information</skos:prefLabel>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasChangeReasonDescription">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Explanatory text about why the element is altered. (epo:ChangeInformation)</skos:definition>
    <skos:editorialNote xml:lang="en">Used by eForms BT-762</skos:editorialNote>
    <skos:prefLabel xml:lang="en">has Change Reason Description</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasDebitedAccountIdentifier">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">An identifier for the account to be debited by the direct debit.</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 11/07/2024</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Debited Account Identifier</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasWithdrawalReason">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The explanation for withdrawing the request for review. (epo:ReviewDecision)</skos:definition>
    <skos:editorialNote xml:lang="en">Used by eForms BT-798</skos:editorialNote>
    <skos:prefLabel xml:lang="en">has Withdrawal Reason</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#announcesLotGroup">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating the formal communication of a Lot Group.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">announces Lot Group</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasMaskableProperty">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Resource that has a hidden value. (epo:NonPublishedInformation)</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 09/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Maskable Property</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#attestedByLabel">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating which label the certificate is about.</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 28/07/2022</skos:historyNote>
    <skos:prefLabel xml:lang="en">attested By Label</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasAwardDecisionDate">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The official date of the award decision. (epo:AwardDecision)</skos:definition>
    <skos:editorialNote xml:lang="en">Used by eForms BT-1451</skos:editorialNote>
    <skos:historyNote xml:lang="en">WG Approval 09/01/2020</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Award Decision Date</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#Awarder">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#AcquiringParty"/>
    <skos:definition xml:lang="en">A Role of an Agent that signs the Award Decision. Additional information: BT-08 can be Awarding CBP; BG-03 is the Buyer. But Awarding CPB is not the same as the Buyer; the organisations may differ for these roles. Having the Awarder Role allows us to specify which Organisation is involved in the Award Decision.</skos:definition>
    <skos:prefLabel xml:lang="en">Awarder</skos:prefLabel>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#concernsOriginatorRequest">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relates to Originator Request.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">concerns Originator Request</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#providesContractTotalPaymentValue">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Makes available the overall Monetary Value of the Contract to be paid.</skos:definition>
    <skos:editorialNote xml:lang="en">Used by eForms BT-779</skos:editorialNote>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">provides Contract Total Payment Value</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#ParticipationRequestReceiver">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#AcquiringParty"/>
    <skos:definition xml:lang="en">A Role of an Agent responsible for receiving Requests To Participate.</skos:definition>
    <skos:prefLabel xml:lang="en">Participation Request Receiver</skos:prefLabel>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#announcesReviewRequest">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating the formal communication of a Review Request.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">announces Review Request</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#AccessTerm">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#Term"/>
    <skos:definition xml:lang="en">Conditions and stipulations about where and how to access the Procurement Documents.</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 09/03/2021</skos:historyNote>
    <skos:prefLabel xml:lang="en">Access Term</skos:prefLabel>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasAbnormallyLowTenders">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Tenders received that were found irregular and non-acceptable due to an abnormally low price or cost. Additional Information The definition implies that abnormally Low Tender Lots are Inadmissible Tender Lots. (epo:SubmissionStatisticalInformation)</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 28/07/2020</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Abnormally Low Tenders</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasInvoiceLineObjectIdentifier">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">An identifier for an object on which the invoice line is based, given by the Seller. Additional Information: It may be a subscription number, telephone number, meter point etc., as applicable.</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 26/06/2024</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Invoice Line Object Identifier</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasEInvoicing">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Electronic means will be used for invoicing in the post-award process. Additional Information: This attribute is used for standard form mappings. (epo:ContractTerm)</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 12/09/2019</skos:historyNote>
    <skos:prefLabel xml:lang="en">has E Invoicing</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#LotGroup">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Combination of several Lots to conduct comparative assessment of the Tenders. Additional Information: The comparative assessment may refer to the Selection Criteria, Award and Value that apply to several Lots. Pending of discussion with eForms Member States may provide that, where more than one lot may be awarded to the same tenderer, contracting authorities may award contracts combining several or all lots where they have specified in the contract notice or in the invitation to confirm interest that they reserve the possibility of doing so and indicate the lots or groups of lots that may be combined.</skos:definition>
    <skos:prefLabel xml:lang="en">Lot Group</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#EAuctionTechnique">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#Technique"/>
    <skos:definition xml:lang="en">A repetitive Technique in which new Prices, revised downwards, and/or new values concerning certain elements of Tenders are bid on-line.</skos:definition>
    <skos:editorialNote xml:lang="en">Used by eForms BT-767</skos:editorialNote>
    <skos:historyNote xml:lang="en">WG approval 20/07/2018</skos:historyNote>
    <skos:prefLabel xml:lang="en">E Auction Technique</skos:prefLabel>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#refersToProcedure">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Reference to a Procedure.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">refers To Procedure</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#includesTender">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Contains Tender.</skos:definition>
    <skos:editorialNote xml:lang="en">Used by eForms BT-3202</skos:editorialNote>
    <skos:historyNote xml:lang="en">WG approval 09/10/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">includes Tender</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasSellerItemID">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The general identifier assigned to the concept as defined by the Seller.​</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 16/05/2023</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Seller Item ID</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#isResponsibilityOfBuyer">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The buyer in charge of the procedure.</skos:definition>
    <skos:prefLabel xml:lang="en">is Responsibility Of Buyer</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#Notice">
