    <skos:definition xml:lang="en">Requirements to be fulfilled by tenders in view of their qualification. (epo:QualificationCriteriaSummary)</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 02/05/2024</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Qualification Condition</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#refersToReviewRequest">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Reference to a Review Request.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">refers To Review Request</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#followsRulesSetBy">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
