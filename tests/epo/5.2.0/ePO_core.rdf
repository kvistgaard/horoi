  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasAlias">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
