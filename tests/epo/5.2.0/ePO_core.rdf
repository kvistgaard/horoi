    <skos:historyNote xml:lang="en">WG Approval 25/03/2021</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Alias</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#specifiesTenderer">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating that the instance of the concept involves the Tenderer.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">specifies Tenderer</skos:prefLabel>
  </owl:ObjectProperty>
