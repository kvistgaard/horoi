    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Planned Duration</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#TaxDocumentation">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#Documentation"/>
    <skos:definition xml:lang="en">Documentation concerning the general regulatory framework for taxes.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 11/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">Tax Documentation</skos:prefLabel>
