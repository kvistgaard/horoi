  </owl:DatatypeProperty>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#SpecificationInformation">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Information about the characteristics and standards used in a technical implementation.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 11/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">Specification Information</skos:prefLabel>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#providesProcurementDocumentsInOfficialLanguage">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating the official language of the provided Procurement Documents.</skos:definition>
    <skos:prefLabel xml:lang="en">provides Procurement Documents In Official Language</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#refersToProject">
