    <skos:historyNote xml:lang="en">WG approval 09/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Qualification Criteria Stated In ESPD Request</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasRoundingAmount">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
