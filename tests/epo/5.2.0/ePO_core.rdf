  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasReceiptParticipationRequestDeadline">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
