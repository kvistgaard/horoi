    <skos:prefLabel xml:lang="en">has Contract Value</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#concernsEnergyEfficiencyItemCategory">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relates to Energy Efficiency Item Category.</skos:definition>
    <skos:prefLabel xml:lang="en">concerns Energy Efficiency Item Category</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasTransportHandlingUnitQuantity">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating the number of the Transport Handling Unit.</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 25/06/2024</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Transport Handling Unit Quantity</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#contextualisedBy">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The place of the AgentInRole in the procurement is expressed by a ProcurementObject.</skos:definition>
    <skos:prefLabel xml:lang="en">contextualised By</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasLegalIdentifier">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The officially registered Identifier.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Legal Identifier</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasTraceID">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The identifier used for tracking the Goods Item. Additional information: An example is the EPC number used in RFID.</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 21/09/2023</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Trace ID</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#indicatesPerformingStaffInformationRequirement">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Obligation to indicate the names and professional qualifications of the staff assigned to performing the contract. (epo:ProcurementCriteriaSummary)</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 02/05/2024</skos:historyNote>
    <skos:prefLabel xml:lang="en">indicates Performing Staff Information Requirement</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#signedByBuyer">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating the Buyer that signs the instance of the concept.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 09/10/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">signed By Buyer</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#AwardingCentralPurchasingBody">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#CentralPurchasingBody"/>
    <skos:definition xml:lang="en">Role of an Agent procuring activities conducted on a permanent basis in the form of the award of Public Contracts or the conclusion of Framework Agreements for works, supplies or services intended for other Buyers. Additional Information: In Public Procurement the Role of Awarding Central purchasing Body is carried out by a Central Purchasing Body for other Contracting Authorities.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 05/08/2021</skos:historyNote>
    <skos:prefLabel xml:lang="en">Awarding Central Purchasing Body</skos:prefLabel>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasEstimatedPercentage">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The estimated proportion foreseen to be subcontracted. (epo:SubcontractingEstimate)</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 07/01/2020</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Estimated Percentage</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasReceiptExpressionDeadline">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Time limit for receipt of expressions of interest. Pending of review by the WG (epo:SubmissionTerm)</skos:definition>
    <skos:prefLabel xml:lang="en">has Receipt Expression Deadline</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#providesOrganisationFinancialCapability">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">A monetary amount representing the financial capability of the Organization. Additional information: Used to represent the general Turnover of the Organization (for statistical purposes).</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 05/03/2024</skos:historyNote>
    <skos:prefLabel xml:lang="en">provides Organisation Financial Capability</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasEstimatedDeliveryPeriod">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The forecasted time period given by the Despatcher to provide the goods and services.</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 18/06/2024</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Estimated Delivery Period</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#CertificationLabel">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/m8g/InformationConcept"/>
    <skos:definition xml:lang="en">Concept that stands for a set of norms, expectations, standards and policies. Additional Information: Such standards may relate to social, ethical and quality etc.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 26/07/2022</skos:historyNote>
    <skos:prefLabel xml:lang="en">Certification Label</skos:prefLabel>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasFollowupContract">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Any subsequent service contract will be awarded to the winner or, in the case of a design contest, winners. (epo:DesignContestRegimeTerm)</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 29/08/2019</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Followup Contract</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasVariantPermission">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The obligation or possibility for tenderers to submit variants or not. Additional Information: Variants are alternative ways to fulfil the buyer's needs as opposed to solutions indicated in the procurement documents. eForms: Whether tenderers are required, allowed or forbidden to submit tenders which fulfil the buyer's needs differently than as proposed in the procurement documents. Additional Information: Further conditions for submitting variant tenders are in the procurement documents.</skos:definition>
    <skos:prefLabel xml:lang="en">has Variant Permission</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#usesEvaluationFormula">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Applies systematic method for assessment.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">uses Evaluation Formula</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasAwardCriterionType">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Category of award criterion.</skos:definition>
    <skos:prefLabel xml:lang="en">has Award Criterion Type</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasPrizeRank">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The position of the prize (e.g. first place, second place) in a design contest list of prizes. (epo:Prize)</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 29/08/2019</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Prize Rank</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#announcesNoticeAwardInformation">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating the formal communication of a Notice Award Information.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">announces Notice Award Information</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#definesMediator">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating a ProcedureTerm has a Mediator.</skos:definition>
    <skos:prefLabel xml:lang="en">defines Mediator</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasURL">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The identifier of a resource. Additional Information For example: 1. The URL of the system from where to access the procurement documents; 2. The URL of the system for the submission of tender documents; 3. The URL of the system from where to download a tool to communicate with the Buyer; 4. The URL of the system used by a Technique to allow Economic Operators to exchange information with the Buyer (e.g. eAuction and DPS Systems) 5. The URL of the system used to exchange information between Buyer and EO for questions and clarifications; (cccev:Evidence) The identifier of a resource. Additional Information For example: 1. The URL of the system from where to access the procurement documents; 2. The URL of the system for the submission of tender documents; 3. The URL of the system from where to download a tool to communicate with the Buyer; 4. The URL of the system used by a Technique to allow Economic Operators to exchange information with the Buyer (e.g. eAuction and DPS Systems) 5. The URL of the system used to exchange information between Buyer and EO for questions and clarifications; (epo:Fund)</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 30/09/2019</skos:historyNote>
    <skos:prefLabel xml:lang="en">has URL</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#isAwardedByCPB">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Procedure is awarded by a Central Purchasing Body. (epo:ProcedureTerm)</skos:definition>
    <skos:prefLabel xml:lang="en">is Awarded By CPB</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#isOneLotOnlyAllowed">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Indicates whether tenders may be submitted for only one Lot. Additional information: This field is used to complement the SubmissionTerms (which are at the Lot level) for the Procedure level which is covered by the regulation (EU)-2015-1986 (modeled in the TED Standard Forms). (epo:ProcedureTerm)</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 23/08/2022</skos:historyNote>
    <skos:prefLabel xml:lang="en">is One Lot Only Allowed</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasVersion">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">A number that identifies a specific state of a document. (epo:Document)</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 18/11/2021</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Version</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#ExpressionOfInterest">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Document presenting an Economic Operator's Request to be considered for Procedures covering a specific domain.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 13/04/2021</skos:historyNote>
    <skos:prefLabel xml:lang="en">Expression Of Interest</skos:prefLabel>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasQuantity">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating that the instance of the concept has a Quantity.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Quantity</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasSerialID">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The identifier assigned to the specific instance of the produced concept.</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 16/05/2023</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Serial ID</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#providesEvidence">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Makes available the Evidence.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">provides Evidence</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasElectronicDigest">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating the digital summary that represents the content of the instance of the concept.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Electronic Digest</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#isFundedBy">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Funding is provided either completely or partially by a Fund. Additional information: Funds may change between the lot and the contract, for example in the case of an emergency crisis, a contract may be financed by a budget that was not foreseen in the call.</skos:definition>
    <skos:editorialNote xml:lang="en">Used by eForms BG - 61, eForms BG - 611</skos:editorialNote>
    <skos:prefLabel xml:lang="en">is Funded By</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#specifiesProcurementCriteriaSummary">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating the Procurement Criteria Summary to be used.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">specifies Procurement Criteria Summary</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasTaxInformation">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating the Tax Information.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Tax Information</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasItemConsumptionSavings">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating the amount of resources an Item saves.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Item Consumption Savings</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#Candidate">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#OfferingParty"/>
    <skos:definition xml:lang="en">The Role of an Agent that has sought an invitation or has been invited to take part in a restricted Procedure, in a competitive Procedure with negotiation, in a negotiated Procedure without prior publication, in a competitive dialogue or in an innovation partnership.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 30/05/2023</skos:historyNote>
    <skos:prefLabel xml:lang="en">Candidate</skos:prefLabel>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasServiceReservedToParticularProfession">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Execution of the contract is limited to a particular profession. (epo:ProfessionalSuitabilitySummary)</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 02/05/2024</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Service Reserved To Particular Profession</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasCleanVehicles">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The number of all clean vehicles that have either been purchased, leased, rented, hired-purchased or their use has been contractually committed to for the provision of a purchased service. Additional Information: In the European Union, the legal requirements and scope for the provision of these vehicles or services are covered by Directive 2009/33/EC. (epo:CleanVehicleDirectiveInformation)</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 28/07/2020</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Clean Vehicles</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasTenderSubcontractingInformation">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The information about subcontracting that must be indicated in the tender.</skos:definition>
    <skos:prefLabel xml:lang="en">has Tender Subcontracting Information</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasEstimatedContractNoticePublicationDate">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Foreseen date for publication of Contract Notice. (epo:ProcessPlanningTerm)</skos:definition>
    <skos:editorialNote xml:lang="en">Used by eForms BT-127</skos:editorialNote>
    <skos:prefLabel xml:lang="en">has Estimated Contract Notice Publication Date</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasMinimumTemperature">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The lowest tolerated temperature.</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 18/06/2024</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Minimum Temperature</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasAcceleratedProcedureJustification">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The reasons why the procedure is accelerated. Additional Information: A procedure is accelerated to cover needs of extraordinary circumstances ie earthquake relief. (epo:Procedure)</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 09/06/2020</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Accelerated Procedure Justification</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#isExecutedByProcurementServiceProvider">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating the Procurement Service Provider that carries out the instance of the concept.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">is Executed By Procurement Service Provider</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasNetQuantity">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The net quantity of the item that is contained in each consumable unit, excluding any packaging materials.</skos:definition>
    <skos:prefLabel xml:lang="en">has Net Quantity</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#concernsTender">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relates to Tender.</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 14/05/2024</skos:historyNote>
    <skos:prefLabel xml:lang="en">concerns Tender</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#NonDisclosureAgreementTerm">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#Term"/>
    <skos:definition xml:lang="en">Conditions and stipulations about a non-disclosure agreement. Additional information: A non-disclosure agreement is a Contract between different parties which ensures information is not shared with other parties.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 26/03/2024</skos:historyNote>
    <skos:prefLabel xml:lang="en">Non Disclosure Agreement Term</skos:prefLabel>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#isSubordinatedToContract">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating that the instance of the concept is governed by a specific Contract.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">is Subordinated To Contract</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#specifiesEconomicOperator">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating that the instance of the concept involves the Economic Operator.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">specifies Economic Operator</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#isSubcontractingValueKnown">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Indicates whether the amount of the Subcontracting Estimate is defined. (epo:SubcontractingEstimate)</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 09/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">is Subcontracting Value Known</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasConditionVerificationMethod">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Means used to validate the qualification requirements. (epo:QualificationCriteriaSummary)</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 02/05/2024</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Condition Verification Method</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasMaximumFrameworkAgreementAwardedValue">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The maximum value which can be spent through all the framework agreements announced in this notice, including options and renewals of contracts. Additional information: The value provided is a threshold value that implicity means that it cannot be exceeded however it may not be reached during the execution of a contract. The Framework Agreements in a CAN are to be traced back and added to provide this value.</skos:definition>
    <skos:editorialNote xml:lang="en">Used by eForms BT-118</skos:editorialNote>
    <skos:historyNote xml:lang="en">WG Approval 03/12/2019</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Maximum Framework Agreement Awarded Value</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasPaymentServiceProviderIdentifier">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">An identifier for the payment service provider where a payment account is located.</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 11/07/2024</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Payment Service Provider Identifier</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasConsigneeConsignmentID">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The identifier of the the Consignment given by the Consignee.</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 10/06/2024</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Consignee Consignment ID</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#preparesForPotentialProcurementObject">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Gathers information for a possible Procurement Object.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 09/10/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">prepares For Potential Procurement Object</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasUnknownUsageOfSelectionCriterionType">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating that it is not known whether a Selection Criterion type is to be used or not.</skos:definition>
    <skos:prefLabel xml:lang="en">has Unknown Usage Of Selection Criterion Type</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#specifiesCleanVehicleDirectiveVehicleCategory">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating the Clean Vehicle Directive Category.</skos:definition>
    <skos:prefLabel xml:lang="en">specifies Clean Vehicle Directive Vehicle Category</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasDestinationCountryCode">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating the Country code of the destination.</skos:definition>
    <skos:prefLabel xml:lang="en">has Destination Country Code</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#GreenProcurement">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#StrategicProcurement"/>
    <skos:definition xml:lang="en">Approach whereby Buyers seek to procure with a reduced Environmental Impact. Additional Information: The approach may apply to the complete life cycle. The reduced Environmental Impact is in comparison to goods, services and works with the same primary function that would otherwise be procured. Tightly related are article 68 - Life-cycle costing and article 67 - most economically advantageous Tender (see GPP handbook) https://ec.europa.eu/environment/gpp/pdf/Buying-Green-Handbook-3rd-Edition.pdf An instance of the class GreenProcurement is represented in eForms with the code "env-imp" defined in the codelist Strategic-Procurement.Paragraphs) https://ec.europa.eu/environment/gpp/pdf/Buying-Green-Handbook-3rd-Edition.pdf</skos:definition>
    <skos:prefLabel xml:lang="en">Green Procurement</skos:prefLabel>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasPreferredLanguageForProcurementDocument">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating the language in which the Procurement Documents should be submitted.</skos:definition>
    <skos:prefLabel xml:lang="en">has Preferred Language For Procurement Document</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasVehicleID">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The identifier of the Transport Means.</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 25/06/2024</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Vehicle ID</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#announcesLotGroupAwardInformation">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating the formal communication of a Lot Group Award Information.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">announces Lot Group Award Information</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasMinimumQuantityGuaranteedForDelivery">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The minimum quantity of an item that is guaranteed by the seller to be delivered.</skos:definition>
    <skos:prefLabel xml:lang="en">has Minimum Quantity Guaranteed For Delivery</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#includesAccessibilityCriterion">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Explanation as to whether accessibility Criterion are used or not.</skos:definition>
    <skos:prefLabel xml:lang="en">includes Accessibility Criterion</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasBargainPrice">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The value of procured supplies that have used a particularly advantageous opportunity available for a very short time at a value considerably lower than normal market prices.</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 23/05/2023</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Bargain Price</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasAmountValue">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The numeric value of the amount, including decimals. (epo:MonetaryValue)</skos:definition>
    <skos:prefLabel xml:lang="en">has Amount Value</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasOrderabableUnitFactorRate">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:prefLabel xml:lang="en">has Orderabable Unit Factor Rate</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasNetMonetaryValue">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The price amount of an Item exclusive of taxes and after subtracting price discounts.</skos:definition>
    <skos:prefLabel xml:lang="en">has Net Monetary Value</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasDespatchPeriod">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The time period when the Despatcher picks-up the Goods Items to be delivered.</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 16/07/2024</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Despatch Period</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasMember">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating a part of the instance of the concept.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Member</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasApproximateFrameworkAgreementValue">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The estimated value to be spent within the Framework Agreement(s). Additional information: In the case of an Award Decision for a Lot, this relation represents the estimated value for the awarded Framework Agreement. In the case of a Notice, this relation represents the estimated value for all Framework Agreements covered by the Notice.</skos:definition>
    <skos:prefLabel xml:lang="en">has Approximate Framework Agreement Value</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasNumberOfReviewRequests">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The number of requests the buyer received to review any of its decisions. (epo:ReviewRequestSummary)</skos:definition>
    <skos:prefLabel xml:lang="en">has Number Of Review Requests</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#describesAsset">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Characterises Asset.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 09/10/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">describes Asset</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasSubjectMatter">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Description of the share of the contract that is to be subcontracted. Additional information: This can be an aggregate of several subcontracts. (epo:SubcontractingEstimate)</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 09/11/2021</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Subject Matter</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#SelectedCandidateList">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Record of Candidates admitted to take part in award phases of procurements.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 30/05/2023</skos:historyNote>
    <skos:prefLabel xml:lang="en">Selected Candidate List</skos:prefLabel>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#needsToBeAWinner">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The Contractor must be a Winner.</skos:definition>
    <skos:prefLabel xml:lang="en">needs To Be A Winner</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasAdditionalContractNature">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Additional type of acquisition taken into consideration in the contract.</skos:definition>
    <skos:prefLabel xml:lang="en">has Additional Contract Nature</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasReceiptPreliminaryMarketConsultationDeadline">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The time limit until which answers to the Preliminary Market Consultation can be received. (epo:SubmissionTerm)</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 02/05/2024</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Receipt Preliminary Market Consultation Deadline</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasReceptionDate">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Date when a record is acknowledged by an Organization. (epo:Document)</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 12/05/2020</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Reception Date</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#specifiesReviewer">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating that the instance of the concept involves the Reviewer.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">specifies Reviewer</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasInternationalProcurementInstrumentExceptionInformation">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating the International Procurement Instrument Application.</skos:definition>
    <skos:prefLabel xml:lang="en">has International Procurement Instrument Exception Information</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasEOrdering">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Electronic means will be used for requesting and purchasing in the post-award process. (epo:ContractTerm)</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 12/09/2019</skos:historyNote>
    <skos:prefLabel xml:lang="en">has E Ordering</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasOverallCostAwardCriteriaPonderation">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The weighting given to cost. Additional Information: This weighting covers usually all cost criteria against price or quality criteria. (epo:AwardEvaluationTerm)</skos:definition>
    <skos:prefLabel xml:lang="en">has Overall Cost Award Criteria Ponderation</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasContactPointInRole">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating the Agent In Role has a Contact Point.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Contact Point In Role</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#needsToBeATenderer">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The Winner must be a Tenderer.</skos:definition>
    <skos:prefLabel xml:lang="en">needs To Be A Tenderer</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasBuyerCategoryDescription">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">A classification of buyers participating in a framework agreement. Additional Information: Buyers that can use the Framework Agreement not mentioned by name. For example, the classification "all hospitals in the Tuscany region" is used instead of naming each individual buyer. (epo:FrameworkAgreementTerm)</skos:definition>
    <skos:editorialNote xml:lang="en">Used by eForms BT-111</skos:editorialNote>
    <skos:historyNote xml:lang="en">WG Approval 06/05/2019</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Buyer Category Description</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#describesVerificationMethod">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">General explanatory text on the means used to validate the Participation Conditions. (epo:ParticipationConditionsSummary)</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 02/05/2024</skos:historyNote>
    <skos:prefLabel xml:lang="en">describes Verification Method</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasAmount">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The predetermined monetary value charged in addition to the price.</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 26/07/2022</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Amount</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasFundProgramme">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating the EU programme used for funding.</skos:definition>
    <skos:prefLabel xml:lang="en">has Fund Programme</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasBuyerLegalTypeDescription">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Self-explanatory text about the Buyer Legal Type. Additional information: This field is used when the Buyer Legal Type is not available in the controlled list at-voc:buyer-legal-type . This is necessary in to cover data provided in the TED Standard Forms. It shall be deprecated in the future. (org:Organization)</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 06/09/2022</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Buyer Legal Type Description</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasEEAReceivedTenders">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The amount of tenders received from economic operators in other EEA countries other than the country of the buyer. (epo:SubmissionStatisticalInformation)</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 12/12/2019</skos:historyNote>
    <skos:prefLabel xml:lang="en">has EEA Received Tenders</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasReceivedQuantity">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating the delivered Quantity.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Received Quantity</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasPerformanceConditions">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The particular conditions and additional information related to the execution of the contract. Additional Information: For example, specific information about the place of performance, intermediary deliverables, compensation for damages, intellectual property rights. (epo:ContractTerm)</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 15/01/2019</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Performance Conditions</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasBroadPlaceOfPerformance">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Geopolitical zone where the contract can be executed. Additional Information Used for setting restrictions that cannot be established with one country code or a geographical zone identifier (like NUTS), because they have a broader scope (geographical, economic, political, other).</skos:definition>
    <skos:prefLabel xml:lang="en">has Broad Place Of Performance</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasElectronicTenders">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Electronic Tender Lots received. (epo:SubmissionStatisticalInformation)</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 28/07/2020</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Electronic Tenders</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasReviewDecisionType">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating the Review Decision Type.</skos:definition>
    <skos:prefLabel xml:lang="en">has Review Decision Type</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasReceivedParticipationRequests">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The amount of applications to participate from economic operators. (epo:SubmissionStatisticalInformation)</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 12/12/2019</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Received Participation Requests</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#OfflineAccessProvider">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#AcquiringParty"/>
    <skos:definition xml:lang="en">A Role of an Agent responsible for providing offline access to the Procurement Documents.</skos:definition>
    <skos:prefLabel xml:lang="en">Offline Access Provider</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#ProcurementProcessInformation">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#ContextDescription"/>
    <skos:definition xml:lang="en">Information about the temporal unfolding or succession of Procurement Objects.</skos:definition>
    <skos:prefLabel xml:lang="en">Procurement Process Information</skos:prefLabel>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasFormNumber">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The number of the form used to create the Standard Form Notice and not an eForms Notice. (epo:Notice)</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 26/03/2024</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Form Number</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#PurchaseContract">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#Contract"/>
    <skos:definition xml:lang="en">A Contract resulting from using a Dynamic Purchasing System Technique or Framework Agreement Technique.</skos:definition>
    <skos:prefLabel xml:lang="en">Purchase Contract</skos:prefLabel>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasRemedyValue">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating the Monetary Value of a compensation, penalty, or corrective measure applied when a contract, obligation, or agreement is breached or not fulfilled.</skos:definition>
    <skos:editorialNote xml:lang="en">Used by eForms BT-793</skos:editorialNote>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Remedy Value</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasCountryOfOrigin">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The source country of the product or service. Additional Information: The country of origin can be provided by the buyer as a requirement or by the tenderer information of the item to be provided.</skos:definition>
    <skos:prefLabel xml:lang="en">has Country Of Origin</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#summarisesInformationForAwardOutcome">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relates to submission for the given competition, either at Lot level or Mini-Competition level.</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 30/05/2023</skos:historyNote>
    <skos:prefLabel xml:lang="en">summarises Information For Award Outcome</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasDeclaredStatisticalValue">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The Monetary Value declared for statistical purposes.</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 10/06/2024</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Declared Statistical Value</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasRegistrationCountry">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating the official country.</skos:definition>
    <skos:prefLabel xml:lang="en">has Registration Country</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasOpeningPlace">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The place (e.g. physical address, URL) where the tenders will be publicly opened. (epo:OpeningTerm)</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 06/03/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Opening Place</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#resultsFromLotAwardOutcome">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation to indicate that a given type of Contract is a consequence of a given Lot Award Outcome.</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 15/10/2024</skos:historyNote>
    <skos:prefLabel xml:lang="en">results From Lot Award Outcome</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasWithdrawalDate">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The date and time when the request for review was withdrawn. (epo:ReviewDecision)</skos:definition>
    <skos:editorialNote xml:lang="en">Used by eForms BT-797</skos:editorialNote>
    <skos:prefLabel xml:lang="en">has Withdrawal Date</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasReferenceURI">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">A reference to where the label specification (norms, expectations, standards and policies) can be found. (epo:CertificationLabel)</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 26/07/2022</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Reference URI</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasElementReference">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Reference to the class instance in the current notice. (epo:ReviewInformation)</skos:definition>
    <skos:editorialNote xml:lang="en">Used by eForms BT-13716, eForms BT-786, eForms BT-1501</skos:editorialNote>
    <skos:prefLabel xml:lang="en">has Element Reference</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#LeadBuyer">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#Buyer"/>
    <skos:definition xml:lang="en">A Role of an Agent who is a Buyer and takes the administrative lead of the Procedure.</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 22/11/2022</skos:historyNote>
    <skos:prefLabel xml:lang="en">Lead Buyer</skos:prefLabel>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasBuyerProfile">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Website address where the buyer publishes information on its procurement procedures and general information. (epo:Buyer)</skos:definition>
    <skos:editorialNote xml:lang="en">Used by eForms BT-508</skos:editorialNote>
    <skos:historyNote xml:lang="en">WG approval 04/05/2018</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Buyer Profile</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#describesObjectiveParticipationRules">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">General explanatory text on the rules and criteria to be fulfilled by the Tender. (epo:ParticipationConditionsSummary)</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 02/05/2024</skos:historyNote>
    <skos:prefLabel xml:lang="en">describes Objective Participation Rules</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#isContractingEntity">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Role of entities, which: (a) are contracting authorities or public undertakings and which pursue one of the activities referred to in Articles 8 to 14 of the Directive 2014/25/EU. (b) when they are not contracting authorities or public undertakings, have as one of their activities any of the activities referred to in Articles 8 to 14, or any combination thereof and operate on the basis of special or exclusive rights granted by a competent authority of a Member State. Additional Information: The indicator is needed in order to discriminate between those contracts where the Contracting Entity acts as a Contracting Authority undergoing the limits and the rules of Directive 24 and those where it acts as a Contracting Entity, with certain relaxed constraints. For example, the Contracting Entities have different thresholds for the application of Directive 24 if compared with Contracting Authorities. (epo:Buyer)</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 28/04/2020</skos:historyNote>
    <skos:prefLabel xml:lang="en">is Contracting Entity</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#definesSubcontractingTerm">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating a ContractTerm has a SubcontractingTerm.</skos:definition>
    <skos:prefLabel xml:lang="en">defines Subcontracting Term</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasQualificationSystemRenewalDescription">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Explanation of how a Qualification System is re-established. Additional information: A Qualification System qualifies an economic operator to take part in a tendering process. Usually, in such cases the economic operator passes the Exclusion Grounds and Selection Criteria. (epo:MultipleStageProcedureTerm)</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 26/03/2024</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Qualification System Renewal Description</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#FrameworkAgreement">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#Contract"/>
    <skos:definition xml:lang="en">An agreement between one or more Contracting Authorities and one or more Economic Operators. Additional Information: When a Framework Agreement is concerned, the FA will result from LotAwardOutcome which describes a Lot which specifies the both the Qualification and Award Criteria.</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 18/05/2021</skos:historyNote>
    <skos:prefLabel xml:lang="en">Framework Agreement</skos:prefLabel>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#isWithdrawn">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The review request was withdrawn. (epo:ReviewDecision)</skos:definition>
    <skos:editorialNote xml:lang="en">Used by eForms BT-796</skos:editorialNote>
    <skos:prefLabel xml:lang="en">is Withdrawn</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#Winner">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#OfferingParty"/>
    <skos:definition xml:lang="en">A Role of an Agent to whom a Lot is awarded.</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 26/10/2021</skos:historyNote>
    <skos:prefLabel xml:lang="en">Winner</skos:prefLabel>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#definesBudgetProvider">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating a ProcedureTerm has a BudgetProvider.</skos:definition>
    <skos:prefLabel xml:lang="en">defines Budget Provider</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasSpecificationInformation">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating the Specification Information.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Specification Information</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasOverallQualityAwardCriteriaPonderation">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The weighting given to quality. Additional Information: This weighting covers usually all quality criteria against price or cost criteria. (epo:AwardEvaluationTerm)</skos:definition>
    <skos:prefLabel xml:lang="en">has Overall Quality Award Criteria Ponderation</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasCurrency">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The identifier of the currency as in the standard code list used.</skos:definition>
    <skos:prefLabel xml:lang="en">has Currency</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasPriceValidity">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:prefLabel xml:lang="en">has Price Validity</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasManufacturerID">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The manufacturer's identifier for the item.</skos:definition>
    <skos:prefLabel xml:lang="en">has Manufacturer ID</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#Project">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">A collaborative enterprise that is carefully planned to achieve a particular aim.</skos:definition>
    <skos:prefLabel xml:lang="en">Project</skos:prefLabel>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#canProvideEvidence">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation showing that an Organization can supply an Evidence with regard to the payment of social security contributions and taxes.</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 12/03/2024</skos:historyNote>
    <skos:prefLabel xml:lang="en">can Provide Evidence</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#definesContractPeriod">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating a ContractTerm has a Period.</skos:definition>
    <skos:prefLabel xml:lang="en">defines Contract Period</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#OfferingParty">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#AgentInRole"/>
    <skos:definition xml:lang="en">The Role of an Agent that acts on the Economic Operator side during a Procurement Process. Additional information: As per the European Procurement Directives the notion of ‘Economic Operators’ should be interpreted in a broad manner so as to include any Persons and/or Entities which offer the execution of works, the supply of products or the provision of services on the market, irrespective of the legal form under which they have chosen to operate. Thus, firms, branches, subsidiaries, partnerships, cooperative societies, limited companies, universities, public or private, and other forms of entities than natural Persons should all fall within the notion of Economic Operator, whether or not they are ‘Legal Persons’ in all circumstances.</skos:definition>
    <skos:prefLabel xml:lang="en">Offering Party</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#ProcurementElement">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Gathering class for critical/central elements in the Procurement Process. TODO: add definition Additional information: Alias: ProcurementComponent</skos:definition>
    <skos:prefLabel xml:lang="en">Procurement Element</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#Buyer">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#AcquiringParty"/>
    <skos:definition xml:lang="en">A Role of an Agent that awards a Contract and/or purchases items. Additional information: In Public Procurement the Role of Buyer is carried out by the following types of Organisation: Contracting Authority, Contracting Entity, a defense Contractor, an international Organisation, or an organisation awarding a Contract subsidized by a Contracting Authority. In Pre-Award, the Buyer generally awards the Contract, however future purchasers may be foreseen. In Post-Award the buyer generally refers to the purchaser of items.</skos:definition>
    <skos:prefLabel xml:lang="en">Buyer</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#ContextualProjection">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Projection of an Entity and all of its properties that hold in a given Situation Context. Additional Information: The contextual projection does not have its own identity (-I), is dependent (+D) on the described Entity, and is anti-rigid (~R) We say that ContextualProjection *describes* an Entity. Adaptation of ContextSlices pattern encoding a 4D view. http://ontologydesignpatterns.org/wiki/Submissions:Context_Slices</skos:definition>
    <skos:prefLabel xml:lang="en">Contextual Projection</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#ContextDescription">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">A description concerning a Procurement Object or a Notice in a specific Situation Context. Additional Information: The description has its own identity (+I) but is dependent (+D) on the concerned Entity. We say that ContextDescription *concerns* an Entity.</skos:definition>
    <skos:prefLabel xml:lang="en">Context Description</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#Documentation">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">A structured collection of records, reports, or supporting materials that provide context or explanation regarding a process, requirement, or decision within a procurement activity.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 11/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">Documentation</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#ProcurementCriterion">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/m8g/Criterion"/>
    <skos:definition xml:lang="en">A criterion specific to Procurement.</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 23/04/2020</skos:historyNote>
    <skos:prefLabel xml:lang="en">Procurement Criterion</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#QualificationCriteriaSummary">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#ProcurementCriteriaSummary"/>
    <skos:definition xml:lang="en">Overview of the Qualification Criteria.</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 19/03/2024</skos:historyNote>
    <skos:prefLabel xml:lang="en">Qualification Criteria Summary</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#StatisticalInformation">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#ContextDescription"/>
    <skos:definition xml:lang="en">Statistical data on the Procedure and the Lot. Additional Information At the present time Procurement Procedures are not fully electronic. At a later date, information on the Tenders received could be inferred by the data in the eProcurement System. Therefore this class is temporal and should cease to exist in fully electronic Procurement. The need for its presence responds also to the alignment with the Regulation (EU) 2019/1780 (eForms). Attention will have to be paid in the future to possible inconsistencies derived from data placed in other classes and data held in the Statistical Information class; e.g. the TenderEvaluation class (see eEvaluation diagram) has the attribute admissibileTender indicator, which in case of being false, may enter in contradiction with the highest or lowest Tender value for that very same inadmissible Tender.</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 12/12/2019</skos:historyNote>
    <skos:prefLabel xml:lang="en">Statistical Information</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#Contract">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">A voluntary, deliberate, and legally binding agreement between two or more competent parties.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 19/03/2024</skos:historyNote>
    <skos:prefLabel xml:lang="en">Contract</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#ProcurementObject">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#MaskableObject"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#ProcurementElement"/>
    <skos:definition xml:lang="en"><![CDATA[The whole or a division of goods, services or works to be procured. Additional Information: Anything that can specify the procurement content (i.e. goods, services, work) is a Procurement Object. In a sense, such an "object" can constitute the "object of a Contract". To test whether something is a Procedure Object check if it can have a Purpose and/or CPV classification (<i>The CPV establishes a single classification system for public procurement aimed at standardising the references used by Contracting Authorities and entities to describe the subject of Procurement Contracts.</i>). Note: Procedure, seems to be an exception from this rule. Because it is a conflated term: it carries process properties and "purpose" properties.]]></skos:definition>
    <skos:prefLabel xml:lang="en">Procurement Object</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#ProcurementCriteriaSummary">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/m8g/Requirement"/>
    <skos:definition xml:lang="en">Overview of the Procurement Criteria.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 19/03/2024</skos:historyNote>
    <skos:prefLabel xml:lang="en">Procurement Criteria Summary</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#CentralPurchasingBody">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#Buyer"/>
    <skos:definition xml:lang="en">Role of an Agent that provides centralised purchasing activities and, possibly, ancillary purchasing activities for other Buyers. Additional Information: In Public Procurement the Role of Central Purchasing Body is carried out by a Contracting Authority for other Contracting Authorities. Contracting Authority procuring activities conducted on a permanent basis, in one of the following forms:[...](b) the award of Public Contracts or the conclusion of Framework Agreements for works, supplies or services intended for Contracting Authorities;</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 05/08/2021</skos:historyNote>
    <skos:prefLabel xml:lang="en">Central Purchasing Body</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#EvaluationTerm">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#Term"/>
    <skos:definition xml:lang="en">Conditions and stipulations defining particularities of the Tender evaluation.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 23/11/2018</skos:historyNote>
    <skos:prefLabel xml:lang="en">Evaluation Term</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#AwardOutcome">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#ContextualProjection"/>
    <skos:definition xml:lang="en">Result concerning the competition that was attributed by the Awarder.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 19/03/2024</skos:historyNote>
    <skos:prefLabel xml:lang="en">Award Outcome</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#Technique">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Method used for conducting Procurement Procedures. Several Techniques can be combined in one single Procurement Procedure (e.g. eAuction can be carried out in a Framework Agreement or DPS).</skos:definition>
    <skos:editorialNote xml:lang="en">Used by eForms BG-706</skos:editorialNote>
    <skos:historyNote xml:lang="en">WG Approval 19/09/2019</skos:historyNote>
    <skos:prefLabel xml:lang="en">Technique</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#AgentInRole">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relative concept that ties an Agent to a part they play in a given Situational Context. Additional information: The classification of roles is based is based on the degree of involvement into the Procurement Process: - Primary (Procurement) Pole is directly involved in the Procurement Process; - Secondary (Procurement sub-) Role is secondary to the Procurement Process - Tertiary (Related) Role is not involved in the Procurement Process.</skos:definition>
    <skos:prefLabel xml:lang="en">Agent In Role</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#Estimate">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#ContextDescription"/>
    <skos:definition xml:lang="en">An approximate calculation or a judgement of the value, number, Quantity or extent of something.</skos:definition>
    <skos:prefLabel xml:lang="en">Estimate</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#StrategicProcurement">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Public Procurement that contributes to achieving pressing policy goals. Additional Information: Specific strategic goals could be, for example, Environmental Protection, innovation, job creation and the development of small and medium enterprises. The subclasses are given by the choices in BT-06 Strategic Procurement. Based on https://legalinstruments.oecd.org/en/instruments/OECD-LEGAL-0411 (see paragraph on "background information".</skos:definition>
    <skos:editorialNote xml:lang="en">Used by eForms BG-713</skos:editorialNote>
    <skos:historyNote xml:lang="en">WG Approval 10/03/2020</skos:historyNote>
    <skos:prefLabel xml:lang="en">Strategic Procurement</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#SelectionCriteriaSummary">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#QualificationCriteriaSummary"/>
    <skos:definition xml:lang="en">Overview of the Selection Criteria.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 19/03/2024</skos:historyNote>
    <skos:prefLabel xml:lang="en">Selection Criteria Summary</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#MaskableObject">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Entity within the procurement data model whose visibility, accessibility, or disclosure may be conditionally restricted due to legal, confidentiality, or security requirements.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 11/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">Maskable Object</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#Term">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">A governing condition or stipulation.</skos:definition>
    <skos:prefLabel xml:lang="en">Term</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#QualificationCriterion">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#ProcurementCriterion"/>
    <skos:definition xml:lang="en">Criterion used in the first stage of procurement.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 30/05/2023</skos:historyNote>
    <skos:prefLabel xml:lang="en">Qualification Criterion</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#AcquiringParty">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#AgentInRole"/>
    <skos:definition xml:lang="en">The Role of an Agent that acts on the buying side of a Procurement Process.</skos:definition>
    <skos:prefLabel xml:lang="en">Acquiring Party</skos:prefLabel>
  </owl:Class>
</rdf:RDF>
