    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">follows Rules Set By</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#resultsFromMiniCompetitionAwardOutcome">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation to indicate that a given type of Purchase Contract is a consequence of a given Mini Competition Award Outcome.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">results From Mini Competition Award Outcome</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#doesNotRequireSelectionCriterionType">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating that a Selection Criterion type is not used.</skos:definition>
    <skos:prefLabel xml:lang="en">does Not Require Selection Criterion Type</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#specifiesReviewRequester">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating that the instance of the concept involves the Review Requester.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">specifies Review Requester</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#refersToNotice">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Reference to a Notice.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 12/03/2024</skos:historyNote>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">refers To Notice</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#ReviewRequest">
