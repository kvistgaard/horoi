    <skos:historyNote xml:lang="en">WG Approval 14/09/2021</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Jury Member</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasBaseQuantity">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
