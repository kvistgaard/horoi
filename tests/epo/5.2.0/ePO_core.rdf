    <skos:historyNote xml:lang="en">WG Approval 12/12/2019</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Received Tenders</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#signedByContractor">
