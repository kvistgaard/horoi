<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
  xmlns:owl="http://www.w3.org/2002/07/owl#"
  xmlns:dcterms="http://purl.org/dc/terms/"
  xmlns:vann="http://purl.org/vocab/vann/"
  xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
  xmlns:skos="http://www.w3.org/2004/02/skos/core#"
  xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#providesRankToTender">
    <rdfs:isDefinedBy>
      <owl:Ontology rdf:about="http://data.europa.eu/a4g/ontology#eva">
        <rdfs:label xml:lang="en">eProcurement Ontology Evaluation - core</rdfs:label>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-06-01</dcterms:created>
        <dcterms:description xml:lang="en">The eProcurement Ontology Evaluation core describes the concepts and properties representing the European Public Procurement Evaluation domain. The provision of these semantics offers the basis for a common understanding of the domain for all stakeholders ensuring the quality of data exchange and transparency. The ontology restrictions are published in a separate artefact.</dcterms:description>
        <dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-10-10</dcterms:issued>
        <dcterms:license>© European Union, 2014. Unless otherwise noted, the reuse of the Ontology is authorised under the European Union Public Licence v1.2 (https://eupl.eu/).</dcterms:license>
        <dcterms:publisher>http://publications.europa.eu/resource/authority/corporate-body/PUBL</dcterms:publisher>
        <dcterms:title xml:lang="en">eProcurement Ontology Evaluation - core</dcterms:title>
        <vann:preferredNamespacePrefix>epo</vann:preferredNamespacePrefix>
        <vann:preferredNamespaceUri>http://data.europa.eu/a4g/ontology#</vann:preferredNamespaceUri>
        <rdfs:comment>This version is automatically generated from eEvaluation.xml on 2025-10-10</rdfs:comment>
        <rdfs:seeAlso rdf:resource="https://docs.ted.europa.eu/home/index.html"/>
        <rdfs:seeAlso rdf:resource="https://github.com/OP-TED/ePO/releases"/>
        <rdfs:seeAlso rdf:resource="https://joinup.ec.europa.eu/collection/eprocurement/solution/eprocurement-ontology/about"/>
        <rdfs:seeAlso rdf:resource="https://op.europa.eu/en/web/eu-vocabularies/e-procurement"/>
        <owl:imports rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <owl:imports rdf:resource="http://data.europa.eu/eli/ontology#"/>
        <owl:imports rdf:resource="http://data.europa.eu/m8g/"/>
        <owl:imports rdf:resource="http://purl.org/dc/terms/"/>
        <owl:imports rdf:resource="http://www.w3.org/2004/02/skos/core#"/>
        <owl:imports rdf:resource="http://www.w3.org/2006/time"/>
        <owl:imports rdf:resource="http://www.w3.org/ns/adms"/>
        <owl:imports rdf:resource="http://www.w3.org/ns/locn"/>
        <owl:imports rdf:resource="http://www.w3.org/ns/org#"/>
        <owl:imports rdf:resource="http://www.w3.org/ns/person"/>
        <owl:incompatibleWith>4.2.0</owl:incompatibleWith>
        <owl:priorVersion>http://data.europa.eu/a4g/ontology#eva-5.1.0</owl:priorVersion>
        <owl:versionIRI rdf:resource="http://data.europa.eu/a4g/ontology#eva-5.2.0"/>
        <owl:versionInfo>5.2.0</owl:versionInfo>
      </owl:Ontology>
    </rdfs:isDefinedBy>
    <skos:definition xml:lang="en">Makes available the assigned position for the Tender.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">provides Rank To Tender</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#EvaluationReport">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#eva"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#Document"/>
    <skos:definition xml:lang="en">Summary of the Evaluation.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 16/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">Evaluation Report</skos:prefLabel>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#containsCandidate">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#eva"/>
    <skos:prefLabel xml:lang="en">contains Candidate</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasAwardCriteriaEvaluationScore">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#eva"/>
    <skos:definition xml:lang="en">The total number of points obtained while assessing the Award Criteria. (epo-eva:EvaluationReport)</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2026</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Award Criteria Evaluation Score</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#fulfillsProcurementCriterion">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#eva"/>
    <skos:definition xml:lang="en">Indicates whether the Procurement Criterion is satisfied. (epo-eva:EvaluationCriterion)</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2026</skos:historyNote>
    <skos:prefLabel xml:lang="en">fulfills Procurement Criterion</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#playedBy">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#eva"/>
    <skos:definition xml:lang="en">Relation indicating the Agent that fulfills the function of the instance of the concept.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 09/10/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">played By</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasEvaluationJustification">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#eva"/>
    <skos:definition xml:lang="en">The motivation behind the Evaluation result. (epo-eva:EvaluationCriterion)</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2026</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Evaluation Justification</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#Evaluator">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#eva"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#AcquiringParty"/>
    <skos:definition xml:lang="en">A Role of an Agent that asses the Tender submitted for a Lot.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 16/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">Evaluator</skos:prefLabel>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#usesEvaluationFormula">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#eva"/>
    <skos:definition xml:lang="en">Applies systematic method for assessment.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">uses Evaluation Formula</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#isAssignedForEvaluationOf">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#eva"/>
    <skos:definition xml:lang="en">Relation indicating that the instance of the concept is selected for Evaluation.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">is Assigned For Evaluation Of</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#ExcludedCandidateList">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#eva"/>
    <skos:definition xml:lang="en">Record of Candidates prevented from participating in a Procurement because one or more Exclusion Grounds apply.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 16/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">Excluded Candidate List</skos:prefLabel>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#requestsClarification">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#eva"/>
    <skos:definition xml:lang="en">Asks for more information.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">requests Clarification</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#isAppointedBy">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#eva"/>
    <skos:definition xml:lang="en">Relation indicating that by whom the instance of the concept is formally assigned.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">is Appointed By</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#TenderClarificationRequest">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#eva"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#Document"/>
    <skos:definition xml:lang="en">A demand for elucidation of specific aspects of the Tender. Additional Information: This request and its answer may not alter the Tender.</skos:definition>
    <skos:prefLabel xml:lang="en">Tender Clarification Request</skos:prefLabel>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#evaluatesProcurementCriterion">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#eva"/>
    <skos:definition xml:lang="en">Assesses Procurement Criterion.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">evaluates Procurement Criterion</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasEvaluator">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#eva"/>
    <skos:definition xml:lang="en">Relation indicating that the instance of the concept has an Evaluator.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Evaluator</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#reportsEvaluationCriterion">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#eva"/>
    <skos:definition xml:lang="en">Provides an Evaluation Criterion.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">reports Evaluation Criterion</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#concernsEvaluationReport">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#eva"/>
    <skos:definition xml:lang="en">Relates to Evaluation Report.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">concerns Evaluation Report</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasScorePoint">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#eva"/>
    <skos:definition xml:lang="en">The grade value assigned to a Procurement Criterion. (epo-eva:EvaluationCriterion)</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2026</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Score Point</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#refersToTenderClarificationRequest">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#eva"/>
    <skos:definition xml:lang="en">Reference to a Tender Clarification Request.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">refers To Tender Clarification Request</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#TenderClarification">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#eva"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#ProcurementDocument"/>
    <skos:definition xml:lang="en">A Document sent by the Tenderer to the Buyer in response to the Tender Clarification Request. Additional Information: The Tender Clarification may not alter the Tender.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 16/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">Tender Clarification</skos:prefLabel>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#writesEvaluationReport">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#eva"/>
    <skos:definition xml:lang="en">Authors an Evaluation Report.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">writes Evaluation Report</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#EvaluationCriterion">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#eva"/>
    <skos:definition xml:lang="en">A Criterion used by the Buyer to assess and compare Tenders in order to determine which Offer best meets the objectives of the Procurement Procedure.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 11/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">Evaluation Criterion</skos:prefLabel>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#specifiesEconomicOperator">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#eva"/>
    <skos:definition xml:lang="en">Relation indicating that the instance of the concept involves the Economic Operator.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">specifies Economic Operator</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#EvaluationBoard">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#eva"/>
    <skos:definition xml:lang="en">Committee set up to evaluate the Tenders submitted. Additional Information: The committee may be a regular board or a jury.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 13/04/2021</skos:historyNote>
    <skos:prefLabel xml:lang="en">Evaluation Board</skos:prefLabel>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasJuryMember">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#eva"/>
    <skos:definition xml:lang="en">An agent involved in an evaluation board.</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 14/09/2021</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Jury Member</skos:prefLabel>
  </owl:ObjectProperty>
</rdf:RDF>
