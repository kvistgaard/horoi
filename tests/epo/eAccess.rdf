  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#refersToNotice">
    <rdfs:isDefinedBy>
      <owl:Ontology rdf:about="http://data.europa.eu/a4g/ontology#acc">
        <rdfs:label xml:lang="en">eProcurement Ontology Access - core</rdfs:label>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-06-01</dcterms:created>
        <dcterms:description xml:lang="en">The eProcurement Ontology Access core describes the concepts and properties representing the European Public Procurement Access domain. The provision of these semantics offers the basis for a common understanding of the domain for all stakeholders ensuring the quality of data exchange and transparency. The ontology restrictions are published in a separate artefact.</dcterms:description>
        <dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-10-10</dcterms:issued>
        <dcterms:license>© European Union, 2014. Unless otherwise noted, the reuse of the Ontology is authorised under the European Union Public Licence v1.2 (https://eupl.eu/).</dcterms:license>
        <dcterms:publisher>http://publications.europa.eu/resource/authority/corporate-body/PUBL</dcterms:publisher>
        <dcterms:title xml:lang="en">eProcurement Ontology Access - core</dcterms:title>
        <vann:preferredNamespacePrefix>epo</vann:preferredNamespacePrefix>
        <vann:preferredNamespaceUri>http://data.europa.eu/a4g/ontology#</vann:preferredNamespaceUri>
        <rdfs:comment>This version is automatically generated from eAccess.xml on 2025-10-10</rdfs:comment>
        <rdfs:seeAlso rdf:resource="https://docs.ted.europa.eu/home/index.html"/>
        <rdfs:seeAlso rdf:resource="https://github.com/OP-TED/ePO/releases"/>
        <rdfs:seeAlso rdf:resource="https://joinup.ec.europa.eu/collection/eprocurement/solution/eprocurement-ontology/about"/>
        <rdfs:seeAlso rdf:resource="https://op.europa.eu/en/web/eu-vocabularies/e-procurement"/>
        <owl:imports rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <owl:imports rdf:resource="http://data.europa.eu/a4g/ontology#sub"/>
        <owl:imports rdf:resource="http://data.europa.eu/eli/ontology#"/>
        <owl:imports rdf:resource="http://data.europa.eu/m8g/"/>
        <owl:imports rdf:resource="http://purl.org/dc/terms/"/>
        <owl:imports rdf:resource="http://www.w3.org/2004/02/skos/core#"/>
        <owl:imports rdf:resource="http://www.w3.org/2006/time"/>
        <owl:imports rdf:resource="http://www.w3.org/ns/adms"/>
        <owl:imports rdf:resource="http://www.w3.org/ns/locn"/>
        <owl:imports rdf:resource="http://www.w3.org/ns/org#"/>
        <owl:imports rdf:resource="http://www.w3.org/ns/person"/>
        <owl:incompatibleWith>4.2.0</owl:incompatibleWith>
        <owl:priorVersion>http://data.europa.eu/a4g/ontology#acc-5.1.0</owl:priorVersion>
        <owl:versionIRI rdf:resource="http://data.europa.eu/a4g/ontology#acc-5.2.0"/>
        <owl:versionInfo>5.2.0</owl:versionInfo>
      </owl:Ontology>
    </rdfs:isDefinedBy>
    <skos:definition xml:lang="en">Reference to a Notice.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 12/03/2024</skos:historyNote>
    <skos:prefLabel xml:lang="en">refers To Notice</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#concernsProcedure">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#acc"/>
    <skos:definition xml:lang="en">Relates to Procedure.</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 05/03/2024</skos:historyNote>
    <skos:prefLabel xml:lang="en">concerns Procedure</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#relatesToESPDRequest">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#acc"/>
    <skos:definition xml:lang="en">Is about an European Single Procurement Document (ESPD) Request.</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 05/03/2024</skos:historyNote>
    <skos:prefLabel xml:lang="en">relates To ESPD Request</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#ESPDRequest">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#acc"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#ProcurementDocument"/>
    <skos:definition xml:lang="en">A document issued by a Buyer defining how the Exclusion Grounds and the Selection Criteria should be addressed in an European Single Procurement Document for a specific procurement.</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 05/03/2024</skos:historyNote>
    <skos:prefLabel xml:lang="en">ESPD Request</skos:prefLabel>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasSubdivision">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#acc"/>
    <skos:definition xml:lang="en">Relation indicating the Subdivision.</skos:definition>
    <skos:prefLabel xml:lang="en">has Subdivision</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasResourceType">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#acc"/>
    <skos:definition xml:lang="en">Relation indicating the Resource Type.</skos:definition>
    <skos:prefLabel xml:lang="en">has Resource Type</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#specifiesProcurementCriterion">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#acc"/>
    <skos:definition xml:lang="en">Relation indicating the Procurement Criterion to be used.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">specifies Procurement Criterion</skos:prefLabel>
  </owl:ObjectProperty>
</rdf:RDF>
