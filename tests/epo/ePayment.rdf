<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
  xmlns:owl="http://www.w3.org/2002/07/owl#"
  xmlns:dcterms="http://purl.org/dc/terms/"
  xmlns:vann="http://purl.org/vocab/vann/"
  xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
  xmlns:skos="http://www.w3.org/2004/02/skos/core#"
  xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#specifiesSeller">
    <rdfs:isDefinedBy>
      <owl:Ontology rdf:about="http://data.europa.eu/a4g/ontology#pay">
        <rdfs:label xml:lang="en">eProcurement Ontology Payment - core</rdfs:label>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-06-01</dcterms:created>
        <dcterms:description xml:lang="en">The eProcurement Ontology Payment core describes the concepts and properties representing the European Public Procurement Payment domain. The provision of these semantics offers the basis for a common understanding of the domain for all stakeholders ensuring the quality of data exchange and transparency. The ontology restrictions are published in a separate artefact.</dcterms:description>
        <dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-10-10</dcterms:issued>
        <dcterms:license>© European Union, 2014. Unless otherwise noted, the reuse of the Ontology is authorised under the European Union Public Licence v1.2 (https://eupl.eu/).</dcterms:license>
        <dcterms:publisher>http://publications.europa.eu/resource/authority/corporate-body/PUBL</dcterms:publisher>
        <dcterms:title xml:lang="en">eProcurement Ontology Payment - core</dcterms:title>
        <vann:preferredNamespacePrefix>epo</vann:preferredNamespacePrefix>
        <vann:preferredNamespaceUri>http://data.europa.eu/a4g/ontology#</vann:preferredNamespaceUri>
        <rdfs:comment>This version is automatically generated from ePayment.xml on 2025-10-10</rdfs:comment>
        <rdfs:seeAlso rdf:resource="https://docs.ted.europa.eu/home/index.html"/>
        <rdfs:seeAlso rdf:resource="https://github.com/OP-TED/ePO/releases"/>
        <rdfs:seeAlso rdf:resource="https://joinup.ec.europa.eu/collection/eprocurement/solution/eprocurement-ontology/about"/>
        <rdfs:seeAlso rdf:resource="https://op.europa.eu/en/web/eu-vocabularies/e-procurement"/>
        <owl:imports rdf:resource="http://data.europa.eu/a4g/ontology#cat"/>
        <owl:imports rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
        <owl:imports rdf:resource="http://data.europa.eu/a4g/ontology#inv"/>
        <owl:imports rdf:resource="http://data.europa.eu/a4g/ontology#ord"/>
        <owl:imports rdf:resource="http://data.europa.eu/eli/ontology#"/>
        <owl:imports rdf:resource="http://data.europa.eu/m8g/"/>
        <owl:imports rdf:resource="http://purl.org/dc/terms/"/>
        <owl:imports rdf:resource="http://www.w3.org/2004/02/skos/core#"/>
        <owl:imports rdf:resource="http://www.w3.org/2006/time"/>
        <owl:imports rdf:resource="http://www.w3.org/ns/adms"/>
        <owl:imports rdf:resource="http://www.w3.org/ns/locn"/>
        <owl:imports rdf:resource="http://www.w3.org/ns/org#"/>
        <owl:imports rdf:resource="http://www.w3.org/ns/person"/>
        <owl:incompatibleWith>4.2.0</owl:incompatibleWith>
        <owl:priorVersion>http://data.europa.eu/a4g/ontology#pay-5.1.0</owl:priorVersion>
        <owl:versionIRI rdf:resource="http://data.europa.eu/a4g/ontology#pay-5.2.0"/>
        <owl:versionInfo>5.2.0</owl:versionInfo>
      </owl:Ontology>
    </rdfs:isDefinedBy>
    <skos:definition xml:lang="en">Relation indicating that the instance of the concept involves the Seller.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">specifies Seller</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#PaymentInformation">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#pay"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#InformationHub"/>
    <skos:definition xml:lang="en">Information about a remittance.</skos:definition>
    <skos:prefLabel xml:lang="en">Payment Information</skos:prefLabel>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#specifiesBuyer">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#pay"/>
    <skos:definition xml:lang="en">Relation indicating that the instance of the concept involves the Buyer.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">specifies Buyer</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasPaymentMeansInformation">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#pay"/>
    <skos:definition xml:lang="en">Relation indicating the Payment Instruction Information.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Payment Means Information</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasPaymentOrderReference">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#pay"/>
    <skos:definition xml:lang="en">Reference to the Payment Order. (epo-pay:RemittanceAdvice)</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2026</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Payment Order Reference</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasTotalPaymentAmount">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#pay"/>
    <skos:definition xml:lang="en">Relation indicating the overall paid Monetary Value.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Total Payment Amount</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasTotalCreditAmount">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#pay"/>
    <skos:definition xml:lang="en">Relation indicating the overall Monetary Value that reduces the amount owed.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Total Credit Amount</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#refersToInvoice">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#pay"/>
    <skos:definition xml:lang="en">Reference to an Invoice.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">refers To Invoice</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#specifiesPayee">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#pay"/>
    <skos:definition xml:lang="en">Relation indicating that the instance of the concept involves the Payee.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">specifies Payee</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasCreditAmount">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#pay"/>
    <skos:definition xml:lang="en">Relation indicating the Monetary Value that reduces the amount owed.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Credit Amount</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasDebitAmount">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#pay"/>
    <skos:definition xml:lang="en">Relation indicating the Monetary Value that increases the amount owed.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Debit Amount</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasPayerReference">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#pay"/>
    <skos:definition xml:lang="en">Reference to the Payer. (epo-pay:RemittanceAdvice)</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2026</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Payer Reference</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasPaymentInformation">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#pay"/>
    <skos:definition xml:lang="en">Relation indicating the Payment Information.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Payment Information</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#comprisesRemittanceAdviceLine">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#pay"/>
    <skos:definition xml:lang="en">Incorporates Remittance Advice Line.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">comprises Remittance Advice Line</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#RemittanceAdvice">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#pay"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#PostAwardDocument"/>
    <skos:definition xml:lang="en">Document sent by the Buyer to the Seller, informing about the payment made.</skos:definition>
    <skos:prefLabel xml:lang="en">Remittance Advice</skos:prefLabel>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="http://data.europa.eu/a4g/ontology#hasPaymentDate">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#pay"/>
    <skos:definition xml:lang="en">The date of the Payment. (epo-pay:PaymentInformation)</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2026</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Payment Date</skos:prefLabel>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="http://data.europa.eu/a4g/ontology#RemittanceAdviceLine">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#pay"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#Line"/>
    <skos:definition xml:lang="en">Details concerning a given Invoice from the Remittance Advice.</skos:definition>
    <skos:prefLabel xml:lang="en">Remittance Advice Line</skos:prefLabel>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasPaymentIdentifier">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#pay"/>
    <skos:definition xml:lang="en">Relation indicating the Identifier of the Payment.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Payment Identifier</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasBalanceAmount">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#pay"/>
    <skos:definition xml:lang="en">Relation indicating the outstanding amount that remains unpaid or unsettled.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Balance Amount</skos:prefLabel>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://data.europa.eu/a4g/ontology#hasTotalDebitAmount">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#pay"/>
    <skos:definition xml:lang="en">Relation indicating the overall Monetary Value that increases the amount owed.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Total Debit Amount</skos:prefLabel>
  </owl:ObjectProperty>
</rdf:RDF>
