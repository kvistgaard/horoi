    "http://purl.org/dc/terms/description": [
      {
        "@language": "en",
        "@value": "The eProcurement Ontology Fulfilment core describes the concepts and properties representing the European Public Procurement Fulfilment domain. The provision of these semantics offers the basis for a common understanding of the domain for all stakeholders ensuring the quality of data exchange and transparency. The ontology restrictions are published in a separate artefact."
      }
    ],
    "http://purl.org/dc/terms/issued": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2025-10-10"
