        "@id": "http://data.europa.eu/a4g/ontology#awa"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "The end date for the mandatory minimum time frame between the communication of a contract award decision and the formal conclusion of the contract, during which unsuccessful Tenderers have the opportunity to challenge the award before it becomes legally binding. (epo-awa:AwardDecisionNotification)"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#historyNote": [
      {
        "@language": "en",
        "@value": "WG approval 25/09/2025"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "has Standstill Period End Date"
      }
    ]
  },
