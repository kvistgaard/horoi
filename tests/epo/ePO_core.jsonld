    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "http://data.europa.eu/a4g/ontology#core"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://data.europa.eu/a4g/ontology#ProcurementObject"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "A legally defined set of administrative activities conducted to conclude one or more Contracts. Additional Information The Procedure is categorised in the law according to different rules determining whether the Procedure is Open, Restricted, Negotiated with or without publicity, etc. (see Procedure Type)."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#historyNote": [
      {
        "@language": "en",
        "@value": "WG Approval 20/08/2019"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Procedure"
      }
    ]
  },
  {
    "@id": "http://data.europa.eu/a4g/ontology#hasOJSIssueNumber",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "http://data.europa.eu/a4g/ontology#core"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "The issue identifier of the Supplement to the EU Official Journal. Additional information: The format of this identifier is XX-YYYY. (epo:Notice)"
      }
    ],
