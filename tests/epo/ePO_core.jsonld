      {
        "@language": "en",
        "@value": "can Provide Non Discriminatory Evidence"
      }
    ]
  },
  {
    "@id": "http://data.europa.eu/a4g/ontology#hasContactPointInRole",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
