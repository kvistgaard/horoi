  {
    "@id": "http://data.europa.eu/a4g/ontology#hasBuyerLegalTypeDescription",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "http://data.europa.eu/a4g/ontology#core"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Self-explanatory text about the Buyer Legal Type. Additional information: This field is used when the Buyer Legal Type is not available in the controlled list at-voc:buyer-legal-type . This is necessary in to cover data provided in the TED Standard Forms. It shall be deprecated in the future. (org:Organization)"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#historyNote": [
      {
        "@language": "en",
        "@value": "WG Approval 06/09/2022"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "has Buyer Legal Type Description"
      }
    ]
  },
  {
    "@id": "http://data.europa.eu/a4g/ontology#hasReceptionDate",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "http://data.europa.eu/a4g/ontology#core"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Date when a record is acknowledged by an Organization. (epo:Document)"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#historyNote": [
      {
        "@language": "en",
        "@value": "WG Approval 12/05/2020"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "has Reception Date"
      }
    ]
  },
  {
    "@id": "http://data.europa.eu/a4g/ontology#MiniCompetitionAwardOutcome",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "http://data.europa.eu/a4g/ontology#core"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://data.europa.eu/a4g/ontology#AwardOutcome"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Result concerning the mini-competition that was attributed by the Awarder. Additional Information: The mini-competition is the process where multiple winners or candidates of previous stages of a procedure bid for a specific procurement. It is typically used in framework agreements where the suppliers have already been pre-selected, and the mini competition is used to determine which supplier is best suited for a particular project or contract. It is also used in a Dynamic Purchasing System where the suppliers come from a list of Candidates."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#historyNote": [
      {
        "@language": "en",
        "@value": "WG Approval 19/03/2024"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Mini Competition Award Outcome"
      }
    ]
  },
  {
    "@id": "http://data.europa.eu/a4g/ontology#TenderAwardOutcome",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "http://data.europa.eu/a4g/ontology#core"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://data.europa.eu/a4g/ontology#ContextualProjection"
      },
      {
        "@id": "http://data.europa.eu/a4g/ontology#MaskableObject"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Result concerning the Tender attributed by the Awarder."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Tender Award Outcome"
      }
    ]
  },
  {
