        "@id": "http://data.europa.eu/a4g/ontology#core"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "The language translation(s) in which the instances of the given concepts are available. These linguistic versions are not an official translation, they are provided only for information."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "has Unofficial Language"
      }
    ]
  },
