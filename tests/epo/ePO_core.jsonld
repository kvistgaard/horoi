        "@id": "http://data.europa.eu/a4g/ontology#ProcurementElement"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "A subdivision of a Planned Procurement that may later become one or more Lots or a self-standing Procedure. Additional Information: A Lot or a Procedure can also cover one or more parts of the Planned Procurement."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#historyNote": [
      {
        "@language": "en",
        "@value": "WG Approval 20/06/2019"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Planned Procurement Part"
      }
    ]
  },
  {
    "@id": "http://data.europa.eu/a4g/ontology#Tenderer",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "http://data.europa.eu/a4g/ontology#core"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://data.europa.eu/a4g/ontology#OfferingParty"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "A Role of an Agent that has submitted a Tender. Additional Information: A Tenderer is an Economic Operator or group of Economic Operators that has submitted a Tender."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#historyNote": [
      {
        "@language": "en",
        "@value": "WG approval 05/08/2021"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Tenderer"
      }
    ]
  },
  {
    "@id": "http://data.europa.eu/a4g/ontology#hasLegalBasis",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
