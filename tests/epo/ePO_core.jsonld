      }
    ],
    "http://www.w3.org/2004/02/skos/core#editorialNote": [
      {
        "@language": "en",
        "@value": "Used by eForms BT-796"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "is Withdrawn"
      }
    ]
  },
  {
    "@id": "http://data.europa.eu/a4g/ontology#hasMinimumSubcontractorsProposedObligation",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "http://data.europa.eu/a4g/ontology#core"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "The minimum percentage of the contract value that the contractor must subcontract. Additional information: This is used for the competitive procedure described in Title III of Directive 2009/81/EC. (epo:SubcontractTerm)"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#historyNote": [
      {
        "@language": "en",
        "@value": "WG Approval 09/11/2021"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "has Minimum Subcontractors Proposed Obligation"
      }
    ]
  },
  {
    "@id": "http://data.europa.eu/a4g/ontology#refersToPreviousProcedure",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
